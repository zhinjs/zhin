{
  "name": "@zhin.js/ai-provider",
  "version": "1.0.0",
  "description": "Owner-scoped AI Provider registration for Zhin Plugin Runtime",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. packages/im/ai-provider/tests"
  },
  "dependencies": {
    "@zhin.js/ai": "workspace:*",
    "@zhin.js/plugin-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": { "node": ">=22.19.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/im/ai-provider"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" }
    }
  },
  "license": "MIT"
}
