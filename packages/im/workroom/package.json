{
  "name": "@zhin.js/workroom",
  "version": "0.0.9",
  "description": "Workroom, Portfolio and Data Governance domain for Zhin.js",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "development": "./src/remote.ts",
      "import": "./lib/remote.js"
    },
    "./scheduler": {
      "types": "./lib/scheduler.d.ts",
      "development": "./src/scheduler.ts",
      "import": "./lib/scheduler.js"
    },
    "./portfolio": {
      "types": "./lib/portfolio.d.ts",
      "development": "./src/portfolio.ts",
      "import": "./lib/portfolio.js"
    },
    "./data-governance": {
      "types": "./lib/data-governance.d.ts",
      "development": "./src/data-governance.ts",
      "import": "./lib/data-governance.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. packages/im/workroom/tests"
  },
  "dependencies": {
    "@zhin.js/agent": "workspace:*",
    "@zhin.js/ai": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/plugin-runtime": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/im/workroom"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./remote": {
        "types": "./lib/remote.d.ts",
        "import": "./lib/remote.js"
      },
      "./scheduler": {
        "types": "./lib/scheduler.d.ts",
        "import": "./lib/scheduler.js"
      },
      "./portfolio": {
        "types": "./lib/portfolio.d.ts",
        "import": "./lib/portfolio.js"
      },
      "./data-governance": {
        "types": "./lib/data-governance.d.ts",
        "import": "./lib/data-governance.js"
      }
    }
  },
  "license": "MIT",
  "private": false
}
