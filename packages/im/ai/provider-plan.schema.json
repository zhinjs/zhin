{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit AI resource import proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/aiPlanService"
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/aiPlanAccount"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/aiPlanProfile"
      }
    },
    "purposes": {
      "$ref": "#/$defs/aiPlanPurposes"
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "Explicit import proposal. Host review/apply creates runtime resources; startup and hot reload never apply it automatically.",
  "$defs": {
    "aiPlanDriver": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "owner",
            "contractVersion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "contractVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "aiPlanModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kinds",
        "protocol"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "language",
              "decision",
              "image"
            ]
          }
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "file"
            ]
          }
        },
        "streaming": {
          "type": "boolean"
        },
        "toolCalling": {
          "type": "boolean"
        },
        "thinking": {
          "type": "boolean"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "aiPlanService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver"
      ],
      "properties": {
        "driver": {
          "$ref": "#/$defs/aiPlanDriver"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/aiPlanModel"
          }
        }
      }
    },
    "aiPlanAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "auth"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "const": "none"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "const": "oauth"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "const": "api-key"
                },
                "source": {
                  "type": "string",
                  "pattern": "^env://[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          ]
        }
      }
    },
    "aiPlanProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "model"
      ],
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "aiPlanLanguagePurpose": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "fallbacks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "aiPlanPurposes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat": {
          "$ref": "#/$defs/aiPlanLanguagePurpose"
        },
        "summary": {
          "$ref": "#/$defs/aiPlanLanguagePurpose"
        },
        "ambient": {
          "$ref": "#/$defs/aiPlanLanguagePurpose"
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "perception": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "minLength": 1
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "shadow",
                        "active"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "topK": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxSelections": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "tools": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "shadow",
                        "active"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "topK": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxSelections": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "memory": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "shadow",
                        "active"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "topK": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxSelections": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "agents": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "shadow",
                        "active"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "topK": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxSelections": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "approval": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "shadow",
                        "active"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "topK": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxSelections": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "ambient": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "shadow",
                        "active"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minConfidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "topK": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "maxSelections": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/aiPlanLanguagePurpose"
          }
        },
        "adapters": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "chat": {
                    "$ref": "#/$defs/aiPlanLanguagePurpose"
                  },
                  "perception": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "profile"
                        ],
                        "properties": {
                          "profile": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fallbacks": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "chat": {
                    "$ref": "#/$defs/aiPlanLanguagePurpose"
                  },
                  "perception": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "profile"
                        ],
                        "properties": {
                          "profile": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fallbacks": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "scenes": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "chat": {
                    "$ref": "#/$defs/aiPlanLanguagePurpose"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
