{
  "name": "zhin.js",
  "version": "6.0.10",
  "description": "Zhin.js IM 核心（<10MB 安装预算）；AI 请另装 @zhin.js/agent",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "development": "./src/agent.ts",
      "import": "./lib/agent.js"
    },
    "./ai": {
      "types": "./lib/ai.d.ts",
      "development": "./src/ai.ts",
      "import": "./lib/ai.js"
    },
    "./jsx": {
      "types": "./lib/jsx.d.ts",
      "development": "./src/jsx.ts",
      "import": "./lib/jsx.js"
    },
    "./jsx-runtime": {
      "types": "./lib/jsx-runtime.d.ts",
      "development": "./src/jsx-runtime.ts",
      "import": "./lib/jsx-runtime.js"
    },
    "./qrcode": {
      "types": "./lib/qrcode.d.ts",
      "development": "./src/qrcode.ts",
      "import": "./lib/qrcode.js"
    },
    "./jsx-dev-runtime": {
      "types": "./lib/jsx-dev-runtime.d.ts",
      "development": "./src/jsx-dev-runtime.ts",
      "import": "./lib/jsx-dev-runtime.js"
    },
    "./contexts": {
      "types": "./lib/zhin-contexts.d.ts",
      "development": "./zhin-contexts.d.ts"
    },
    "./runtime": {
      "types": "./lib/plugin-runtime.d.ts",
      "development": "./src/plugin-runtime.ts",
      "import": "./lib/plugin-runtime.js"
    },
    "./plugin-runtime": {
      "types": "./lib/define-plugin.d.ts",
      "development": "./src/define-plugin.ts",
      "import": "./lib/define-plugin.js"
    },
    "./command": {
      "types": "./lib/command.d.ts",
      "development": "./src/command.ts",
      "import": "./lib/command.js"
    },
    "./adapter": {
      "types": "./lib/adapter.d.ts",
      "development": "./src/adapter.ts",
      "import": "./lib/adapter.js"
    },
    "./component": {
      "types": "./lib/component.d.ts",
      "development": "./src/component.ts",
      "import": "./lib/component.js"
    },
    "./middleware": {
      "types": "./lib/middleware.d.ts",
      "development": "./src/middleware.ts",
      "import": "./lib/middleware.js"
    },
    "./handler": {
      "types": "./lib/handler.d.ts",
      "development": "./src/handler.ts",
      "import": "./lib/handler.js"
    },
    "./core/runtime": {
      "types": "./lib/core-runtime.d.ts",
      "development": "./src/core-runtime.ts",
      "import": "./lib/core-runtime.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rimraf lib && tsc && cp zhin-contexts.d.ts lib/zhin-contexts.d.ts",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@zhin.js/core": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/permission": "workspace:*",
    "@zhin.js/plugin-runtime": "workspace:*",
    "chalk": "^5.6.2"
  },
  "peerDependencies": {
    "@zhin.js/agent": "^1.1.12",
    "@zhin.js/ai": "^1.5.5",
    "@zhin.js/html-renderer": "workspace:^",
    "@zhin.js/speech": "workspace:^",
    "@zhin.js/runtime": "^1.0.12"
  },
  "peerDependenciesMeta": {
    "@zhin.js/agent": {
      "optional": true
    },
    "@zhin.js/ai": {
      "optional": true
    },
    "@zhin.js/html-renderer": {
      "optional": true
    },
    "@zhin.js/speech": {
      "optional": true
    },
    "@zhin.js/runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@zhin.js/agent": "workspace:*",
    "@zhin.js/ai": "workspace:*",
    "@zhin.js/html-renderer": "workspace:*",
    "@zhin.js/kernel": "workspace:*",
    "@zhin.js/runtime": "workspace:*",
    "@zhin.js/speech": "workspace:*",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/im/zhin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "author": {
    "name": "lc-cn",
    "email": "admin@liucl.cn",
    "url": "https://github.com/lc-cn"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./lib/index.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [],
    "plugins": []
  }
}
