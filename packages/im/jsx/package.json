{
  "name": "@zhin.js/jsx",
  "version": "1.1.6",
  "description": "Lazy message JSX trees and explicit HTML serialization for Zhin.js",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./jsx-runtime": {
      "types": "./lib/jsx-runtime.d.ts",
      "development": "./src/jsx-runtime.ts",
      "import": "./lib/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./lib/jsx-dev-runtime.d.ts",
      "development": "./src/jsx-dev-runtime.ts",
      "import": "./lib/jsx-dev-runtime.js"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. packages/im/jsx/tests",
    "test-type": "tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@zhin.js/im-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/im/jsx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./jsx-runtime": {
        "types": "./lib/jsx-runtime.d.ts",
        "import": "./lib/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./lib/jsx-dev-runtime.d.ts",
        "import": "./lib/jsx-dev-runtime.js"
      }
    }
  },
  "license": "MIT",
  "private": false
}
