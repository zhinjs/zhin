{
  "name": "@zhin.js/scaffold-wizard",
  "version": "1.1.13",
  "description": "Shared interactive scaffold wizard for create-zhin-app and @zhin.js/cli",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "prepack": "node scripts/write-stack-version-ranges.mjs",
    "postpack": "node scripts/write-stack-version-ranges.mjs --clean",
    "test": "vitest run --root ../../.. packages/toolkit/scaffold-wizard/tests"
  },
  "dependencies": {
    "@zhin.js/plugin-runtime": "workspace:*",
    "chalk": "^5.6.2",
    "fs-extra": "^11.4.0",
    "inquirer": "^14.0.2",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.0",
    "@zhin.js/runtime": "workspace:*",
    "@zhin.js/config-file": "workspace:*"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/toolkit/scaffold-wizard"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "author": {
    "name": "lc-cn",
    "email": "admin@liucl.cn",
    "url": "https://github.com/lc-cn"
  }
}
