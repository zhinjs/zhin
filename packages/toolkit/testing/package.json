  },
  "peerDependencies": {
    "zhin.js": "workspace:^",
    "@zhin.js/runtime": "workspace:^",
    "@zhin.js/tool": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/command": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/middleware": "workspace:*",
    "@zhin.js/plugin-runtime": "workspace:*",
    "@zhin.js/runtime": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/toolkit/testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
