{
  "name": "@zhin.js/pagemanager",
  "version": "1.1.24",
  "description": "Zhin PageManager Host runtime: entries, esbuild pipeline (no UI; contract in @zhin.js/contract)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/node/index.d.ts",
      "development": "./src/node/index.ts",
      "import": "./lib/node/index.js",
      "default": "./lib/node/index.js"
    },
    "./node": {
      "types": "./lib/node/index.d.ts",
      "development": "./src/node/index.ts",
      "import": "./lib/node/index.js",
      "default": "./lib/node/index.js"
    },
    "./plugin-runtime": {
      "types": "./lib/plugin-runtime/index.d.ts",
      "development": "./src/plugin-runtime/index.ts",
      "import": "./lib/plugin-runtime/index.js"
    },
    "./client-build": {
      "types": "./lib/client-build/index.d.ts",
      "development": "./src/client-build/index.ts",
      "import": "./lib/client-build/index.js"
    },
    "./shell": {
      "types": "./lib/shell/page-renderer.d.ts",
      "development": "./src/shell/page-renderer.ts",
      "import": "./lib/shell/page-renderer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:node": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist lib"
  },
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/contract": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/layout": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/plugin-runtime": "workspace:*",
    "@zhin.js/runtime": "workspace:*",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.8.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "packages/console/pagemanager"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": {
    "name": "lc-cn",
    "email": "admin@liucl.cn",
    "url": "https://github.com/lc-cn"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/node/index.d.ts",
        "import": "./lib/node/index.js",
        "default": "./lib/node/index.js"
      },
      "./node": {
        "types": "./lib/node/index.d.ts",
        "import": "./lib/node/index.js",
        "default": "./lib/node/index.js"
      },
      "./plugin-runtime": {
        "types": "./lib/plugin-runtime/index.d.ts",
        "import": "./lib/plugin-runtime/index.js"
      },
      "./client-build": {
        "types": "./lib/client-build/index.d.ts",
        "import": "./lib/client-build/index.js"
      },
      "./shell": {
        "types": "./lib/shell/page-renderer.d.ts",
        "import": "./lib/shell/page-renderer.js"
      }
    }
  }
