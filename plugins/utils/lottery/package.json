{
  "name": "@zhin.js/plugin-lottery",
  "version": "1.1.23",
  "description": "Draw sync, statistics and scheduled pushes for KL8, SSQ, DLT, 3D and Pick 3/5.",
  "keywords": [
    "zhin.js",
    "lottery",
    "彩票",
    "ssq",
    "dlt"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "pages",
    "src",
    "lib",
    "AGENTS.md",
    "skills",
    "evals",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/utils/lottery/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.4.3",
    "@zhin.js/skill": "workspace:*"
  },
  "devDependencies": {
    "@zhin.js/agent": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/agent": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/agent": {
      "optional": true
    },
    "@zhin.js/command": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/lottery"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Lottery",
      "displayNameI18n": {
        "zh-CN": "彩票分析",
        "en": "Lottery Analysis"
      },
      "descriptionI18n": {
        "zh-CN": "快乐8、双色球、大乐透、福彩3D、排列3/5 的开奖同步、统计与定时推送。",
        "en": "Draw sync, statistics and scheduled pushes for KL8, SSQ, DLT, 3D and Pick 3/5."
      },
      "category": "information"
    }
  }
}
