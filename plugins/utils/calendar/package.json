{
  "name": "@zhin.js/plugin-calendar",
  "version": "0.1.20",
  "description": "CalDAV, Google Calendar and Outlook event lookup and creation for the Agent, with authorization done in chat.",
  "keywords": [
    "zhin.js",
    "calendar",
    "caldav",
    "google-calendar",
    "outlook"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "zhin-calendar-auth": "./lib/cli/auth.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "commands",
    "pages",
    "src",
    "lib",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run --root ../../.. plugins/utils/calendar/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean",
    "auth": "tsx src/cli/auth.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/host-http": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@zhin.js/command": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "@zhin.js/skill": "workspace:^",
    "@zhin.js/tool": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/calendar"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "日历",
      "displayNameI18n": {
        "zh-CN": "日历",
        "en": "Calendar"
      },
      "descriptionI18n": {
        "zh-CN": "为 Agent 提供 CalDAV、Google Calendar 与 Outlook 日程查询和创建，授权在聊天里完成。",
        "en": "CalDAV, Google Calendar and Outlook event lookup and creation for the Agent, with authorization done in chat."
      },
      "category": "utility"
    }
  }
}
