{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "anyOf": [
        {
          "const": "none",
          "default": "none"
        },
        {
          "const": "caldav",
          "default": "caldav"
        },
        {
          "const": "google",
          "default": "google"
        },
        {
          "const": "microsoft",
          "default": "microsoft"
        }
      ],
      "description": "日历后端；none 时工具返回未启用提示",
      "x-i18n": {
        "en": {
          "description": "Calendar backend. Tools report that the calendar is disabled when set to none."
        }
      },
      "default": "none",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "timezone": {
      "type": "string",
      "description": "解释无偏移时间与展示用的 IANA 时区",
      "x-i18n": {
        "en": {
          "description": "IANA timezone for interpreting times without offsets and for display."
        }
      },
      "default": "Asia/Manila",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "work_day_start": {
      "type": "string",
      "default": "09:00",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "work_day_end": {
      "type": "string",
      "default": "18:00",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "oauth_redirect_base_url": {
      "type": "string",
      "description": "聊天授权回调的外部基础地址（如 https://bot.example.com）；留空时使用 zhin HTTP Host 的本机地址",
      "default": "",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "oauth_callback_path": {
      "type": "string",
      "description": "聊天授权回调路由，挂在 zhin HTTP Host 上；反向代理/隧道只转发部分路径时可调整",
      "default": "/calendar/oauth/callback",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "caldav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "calendar_url": {
          "type": "string",
          "description": "日历 collection URL",
          "x-i18n": {
            "en": {
              "description": "Calendar collection URL."
            }
          },
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "username": {
          "type": "string",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "password": {
          "type": "string",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        }
      }
    },
    "google": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "client_id": {
          "type": "string",
          "description": "${GOOGLE_CALENDAR_CLIENT_ID}",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "client_secret": {
          "type": "string",
          "description": "${GOOGLE_CALENDAR_CLIENT_SECRET}",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "refresh_token": {
          "type": "string",
          "description": "${GOOGLE_CALENDAR_REFRESH_TOKEN}；用 auth google 获取",
          "x-i18n": {
            "en": {
              "description": "${GOOGLE_CALENDAR_REFRESH_TOKEN}; obtain using the calendar authorization flow."
            }
          },
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "calendar_id": {
          "type": "string",
          "description": "日历 ID，默认 primary；可换成其它日历的 id",
          "x-i18n": {
            "en": {
              "description": "Calendar ID, primary by default; can be set to another calendar ID."
            }
          },
          "default": "primary",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "token_file": {
          "type": "string",
          "description": "可选：持久化轮换后的 refresh_token 的 JSON 路径（如 data/calendar-google-token.json）",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        }
      }
    },
    "microsoft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "client_id": {
          "type": "string",
          "description": "${MS_GRAPH_CLIENT_ID}",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "client_secret": {
          "type": "string",
          "description": "可选；公共客户端可留空。${MS_GRAPH_CLIENT_SECRET}",
          "x-i18n": {
            "en": {
              "description": "Optional for public clients. ${MS_GRAPH_CLIENT_SECRET}"
            }
          },
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "refresh_token": {
          "type": "string",
          "description": "${MS_GRAPH_REFRESH_TOKEN}；用 auth microsoft 获取",
          "x-i18n": {
            "en": {
              "description": "${MS_GRAPH_REFRESH_TOKEN}; obtain using the calendar authorization flow."
            }
          },
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "tenant": {
          "type": "string",
          "description": "Azure tenant，默认 common",
          "x-i18n": {
            "en": {
              "description": "Azure tenant, common by default."
            }
          },
          "default": "common",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "calendar_id": {
          "type": "string",
          "description": "留空或 primary/me = 默认日历；否则为 Graph calendar id",
          "x-i18n": {
            "en": {
              "description": "Empty, primary or me selects the default calendar; otherwise a Graph calendar ID."
            }
          },
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        },
        "token_file": {
          "type": "string",
          "description": "可选：持久化轮换后的 refresh_token 的 JSON 路径（如 data/calendar-ms-token.json）",
          "default": "",
          "x-zhin-config": {
            "effect": "reload"
          }
        }
      }
    }
  }
}
