{
  "name": "@zhin.js/plugin-answers",
  "version": "0.0.18",
  "description": "The Book of Answers, fun either-or questions and a driving-theory quiz, all original content.",
  "keywords": [
    "zhin.js",
    "book-of-answers",
    "quiz",
    "fun"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "middlewares",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/utils/answers/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/core": "workspace:*"
  },
  "devDependencies": {
    "@zhin.js/testing": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/answers"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "答案之书",
      "displayNameI18n": {
        "zh-CN": "答案之书",
        "en": "Book of Answers"
      },
      "descriptionI18n": {
        "zh-CN": "答案之书、趣味选择题与科目一交规小测，题库原创。",
        "en": "The Book of Answers, fun either-or questions and a driving-theory quiz, all original content."
      },
      "category": "entertainment"
    }
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/middleware": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/middleware": {
      "optional": true
    }
  }
}
