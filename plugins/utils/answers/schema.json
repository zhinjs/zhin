{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dailyStable": {
      "type": "boolean",
      "description": "同一用户同一天问同一个问题时，答案之书给出相同答案",
      "default": false,
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "timezone": {
      "type": "string",
      "description": "dailyStable 判断「同一天」所用的 IANA 时区",
      "default": "Asia/Shanghai",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "quizTimeoutSeconds": {
      "type": "number",
      "description": "出题后等待作答的秒数，超时题目作废",
      "default": 120,
      "minimum": 15,
      "maximum": 600,
      "multipleOf": 1,
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "enableDrivingQuiz": {
      "type": "boolean",
      "description": "启用「科目一」交规小测（原创题面，仅供娱乐参考）",
      "default": true,
      "x-zhin-config": {
        "effect": "reload"
      }
    }
  }
}
