{
  "name": "@zhin.js/plugin-reminder",
  "version": "1.0.0",
  "description": "Persistent personal reminders for Zhin Plugin Runtime",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "development": "./src/index.ts", "import": "./lib/index.js" } },
  "files": ["lib", "src", "plugin.js", "commands", "schedules", "README.md"],
  "scripts": {
    "build": "tsc",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run --root ../../.. plugins/utils/reminder/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": { "@zhin.js/im-contract": "workspace:*" },
  "peerDependencies": { "zhin.js": "workspace:^", "@zhin.js/command": "workspace:^", "@zhin.js/schedule-feature": "workspace:^" },
  "peerDependenciesMeta": { "@zhin.js/command": { "optional": true }, "@zhin.js/schedule-feature": { "optional": true } },
  "devDependencies": { "typescript": "^6.0.3", "vitest": "^4.1.10", "zhin.js": "workspace:*", "@zhin.js/schedule-feature": "workspace:*" },
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/zhinjs/zhin.git", "directory": "plugins/utils/reminder" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "zhin": { "protocol": 1, "type": "plugin", "entry": "./plugin.js", "engine": "^1.0.0", "runtime": "trusted", "features": [{ "package": "@zhin.js/command", "api": "^1.0.0" }, { "package": "@zhin.js/schedule-feature", "api": "^1.0.0" }], "plugins": [] }
}
