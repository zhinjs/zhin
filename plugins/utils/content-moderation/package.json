{
  "name": "@zhin.js/plugin-content-moderation",
  "version": "1.1.28",
  "description": "Multi-source scanning of inbound and outbound messages with configurable severity actions.",
  "keywords": [
    "zhin.js",
    "moderation",
    "content-safety",
    "filter"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "middlewares",
    "pages",
    "skills",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/utils/content-moderation/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/permission": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/content-moderation"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.1.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Content Moderation",
      "displayNameI18n": {
        "zh-CN": "内容审核",
        "en": "Content Moderation"
      },
      "descriptionI18n": {
        "zh-CN": "入站 / 出站多源扫描，按可配置的严重程度执行处置动作。",
        "en": "Multi-source scanning of inbound and outbound messages with configurable severity actions."
      },
      "category": "moderation"
    }
  },
  "peerDependencies": {
    "@zhin.js/middleware": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "@zhin.js/skill": "workspace:^",
    "@zhin.js/tool": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/middleware": {
      "optional": true
    },
    "@zhin.js/page": {
      "optional": true
    },
    "@zhin.js/skill": {
      "optional": true
    },
    "@zhin.js/tool": {
      "optional": true
    }
  }
}
