{
  "name": "@zhin.js/plugin-ledger",
  "version": "1.0.2",
  "description": "Personal expense ledger for Zhin.js (Plugin Runtime): per-user entries in integer cents, period and category summaries, group privacy and an opt-in daily report",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "commands",
    "lib",
    "plugin.js",
    "schedules",
    "src",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run --root ../../.. plugins/utils/ledger/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "keywords": [
    "zhin",
    "zhin.js",
    "bot",
    "plugin",
    "ledger",
    "expense"
  ],
  "author": {
    "name": "lc-cn",
    "email": "admin@liucl.cn",
    "url": "https://github.com/lc-cn"
  },
  "peerDependencies": {
    "zhin.js": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/schedule-feature": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/schedule-feature": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zhin.js/schedule-feature": "workspace:*",
    "@zhin.js/testing": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/ledger"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/schedule-feature",
        "api": "^1.0.0"
      }
    ],
    "plugins": []
  }
}
