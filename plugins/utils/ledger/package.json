{
  "name": "@zhin.js/plugin-ledger",
  "version": "1.0.7",
  "description": "Per-user expense records with daily, weekly and monthly category summaries, amounts hidden in groups, and an opt-in daily report.",
  "keywords": [
    "zhin.js",
    "ledger",
    "expense",
    "bookkeeping",
    "记账"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "commands",
    "lib",
    "pages",
    "plugin.js",
    "schedules",
    "skills",
    "src",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run --root ../../.. plugins/utils/ledger/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zhin.js": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "@zhin.js/schedule-feature": "workspace:^",
    "@zhin.js/skill": "workspace:^",
    "@zhin.js/tool": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/schedule-feature": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zhin.js/schedule-feature": "workspace:*",
    "@zhin.js/testing": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/ledger"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/schedule-feature",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.1.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "记账",
      "displayNameI18n": {
        "zh-CN": "记账",
        "en": "Ledger"
      },
      "descriptionI18n": {
        "zh-CN": "按用户记录消费，按日 / 周 / 月汇总分类明细，群聊不显示金额，可订阅每日日报。",
        "en": "Per-user expense records with daily, weekly and monthly category summaries, amounts hidden in groups, and an opt-in daily report."
      },
      "category": "utility"
    }
  }
}
