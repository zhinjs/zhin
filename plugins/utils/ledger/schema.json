{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timezone": {
      "type": "string",
      "description": "计算今日、本周（周一开始）、本月与日报日期所用的 IANA 时区",
      "default": "Asia/Shanghai",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "reportTime": {
      "type": "string",
      "description": "记账日报的发送时间（HH:MM，按 timezone）；只发给用「记账日报 开启」订阅的用户",
      "default": "22:00",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
      "x-zhin-config": {
        "effect": "reload"
      }
    },
    "reportWhenEmpty": {
      "type": "boolean",
      "description": "当天没有记账时是否仍发送日报",
      "default": false,
      "x-zhin-config": {
        "effect": "reload"
      }
    }
  }
}
