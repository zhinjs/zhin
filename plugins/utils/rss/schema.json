{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pollCron": {
      "type": "string",
      "default": "0 */5 * * * *",
      "description": "轮询频率 (6 段 Cron 表达式)",
      "x-i18n": {
        "en": {
          "description": "Polling schedule (6-field cron expression)."
        }
      }
    },
    "maxPerGroup": {
      "type": "number",
      "default": 30,
      "minimum": 1,
      "maximum": 200
    },
    "maxItems": {
      "type": "number",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    },
    "timeout": {
      "type": "number",
      "default": 15000,
      "minimum": 1000,
      "maximum": 60000
    },
    "allowPrivateNetwork": {
      "type": "boolean",
      "default": false,
      "description": "允许订阅回环/内网地址上的 feed（如自建 RSSHub）。默认拒绝，因为订阅地址来自聊天用户。",
      "x-i18n": {
        "en": {
          "description": "Allow feeds on loopback/LAN addresses (for example a self-hosted RSSHub). Refused by default because feed URLs come from chat users."
        }
      }
    }
  }
}
