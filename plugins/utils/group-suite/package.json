{
  "name": "@zhin.js/plugin-group-suite",
  "version": "1.1.15",
  "description": "Zhin.js 群运营套件：签到、教学、统计、持久词库与群欢迎",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "middlewares",
    "handlers",
    "schedules",
    "src",
    "lib",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "NODE_OPTIONS=--experimental-strip-types vitest run --root ../../.. plugins/utils/group-suite/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "keywords": [
    "zhin",
    "zhin.js",
    "bot",
    "plugin",
    "group",
    "checkin",
    "stats",
    "teach"
  ],
  "author": {
    "name": "lc-cn",
    "email": "admin@liucl.cn",
    "url": "https://github.com/lc-cn"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/components": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/jsx": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/middleware": "workspace:^",
    "zhin.js": "workspace:^",
    "zod": "^4.0.0",
    "@zhin.js/handler": "workspace:^",
    "@zhin.js/schedule-feature": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/middleware": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@zhin.js/handler": {
      "optional": true
    },
    "@zhin.js/schedule-feature": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/group-suite"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/handler",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/schedule-feature",
        "api": "^1.0.0"
      }
    ],
    "plugins": []
  }
}
