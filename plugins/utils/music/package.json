{
  "name": "@zhin.js/plugin-music",
  "version": "1.1.28",
  "description": "Search QQ Music and NetEase Cloud Music and share song cards.",
  "keywords": [
    "zhin.js",
    "music",
    "qq-music",
    "netease-music"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "middlewares",
    "components",
    "src",
    "lib",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/utils/music/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/core": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "@zhin.js/skill": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/component": "workspace:^",
    "@zhin.js/middleware": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/component": {
      "optional": true
    },
    "@zhin.js/middleware": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/music"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/component",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Music",
      "displayNameI18n": {
        "zh-CN": "点歌",
        "en": "Music"
      },
      "descriptionI18n": {
        "zh-CN": "搜索 QQ 音乐、网易云音乐并分享歌曲卡片。",
        "en": "Search QQ Music and NetEase Cloud Music and share song cards."
      },
      "category": "entertainment"
    }
  }
}
