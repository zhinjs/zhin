{
  "name": "@zhin.js/plugin-short-url",
  "version": "1.1.22",
  "description": "Shorten links and expand them, checking every redirect hop for safety.",
  "keywords": [
    "zhin.js",
    "short-url",
    "url-shortener",
    "短链接"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "commands",
    "pages",
    "src",
    "lib",
    "skills",
    "README.md",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/utils/short-url/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/utils/short-url"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Short URL",
      "displayNameI18n": {
        "zh-CN": "短链接",
        "en": "Short URL"
      },
      "descriptionI18n": {
        "zh-CN": "生成与还原短链接，还原时逐跳校验地址安全。",
        "en": "Shorten links and expand them, checking every redirect hop for safety."
      },
      "category": "utility"
    }
  },
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.6.7"
  }
}
