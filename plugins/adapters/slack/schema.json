{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "socketMode": {
      "type": "boolean",
      "default": true,
      "description": "Prefer Socket Mode (default). Set false for HTTP Events via httpHostToken."
    },
    "webhookPath": {
      "type": "string",
      "default": "/slack/events"
    },
    "clientPingTimeout": {
      "type": "number",
      "default": 15000,
      "description": "Socket Mode client ping timeout (ms)"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（Slack user id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖"
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted Slack user id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（Slack user id）；覆盖顶层 master"
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted Slack user id"
            },
            "description": "本 endpoint 的 trusted 列表"
          },
          "token": {
            "type": "string",
            "description": "Bot User OAuth Token (xoxb-...)"
          },
          "signingSecret": {
            "type": "string",
            "description": "Required for HTTP Events API (socketMode: false)"
          },
          "appToken": {
            "type": "string",
            "description": "App-Level Token (xapp-...) for Socket Mode"
          },
          "socketMode": {
            "type": "boolean"
          },
          "webhookPath": {
            "type": "string"
          },
          "clientPingTimeout": {
            "type": "number"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Slack bot name"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$"
              }
            },
            "required": [
              "port",
              "serverName"
            ],
            "description": "Socket故障验收：WSS固定loopback TCP，API仍标准TLS直连"
          },
          "webApiProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "port"
            ],
            "description": "出站JSON Web API专用故障代理：仅slack.com:443，固定loopbackTCP，保留SNI和证书校验，与Socket代理独立；上传域名不适用"
          }
        },
        "required": [
          "id",
          "token"
        ]
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖"
    }
  },
  "required": [
    "endpoints"
  ]
}
