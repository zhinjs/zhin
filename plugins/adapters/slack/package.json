{
  "name": "@zhin.js/adapter-slack",
  "version": "1.1.29",
  "description": "Slack adapter: Socket Mode by default or the HTTP Events API, with Block Kit messages.",
  "keywords": [
    "zhin.js",
    "slack",
    "socket-mode",
    "events-api"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/zhinjs/zhin.git",
    "type": "git",
    "directory": "plugins/adapters/slack"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/slack/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.19.0",
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/agent-feature": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/host-http": "workspace:*",
    "@zhin.js/host-http-contract": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "@zhin.js/host-http": "workspace:^",
    "@zhin.js/permission": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "zhin.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.1",
    "zhin.js": "workspace:*"
  },
  "files": [
    "adapters",
    "commands",
    "pages",
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "agents",
    "README.md",
    "CHANGELOG.md",
    "PERMITS.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.1.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/agent-feature",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Slack Adapter",
      "displayNameI18n": {
        "zh-CN": "Slack 适配器",
        "en": "Slack Adapter"
      },
      "descriptionI18n": {
        "zh-CN": "Slack 适配器：默认 Socket Mode 长连接，也可经 HTTP Events API 收发消息，支持 Block Kit。",
        "en": "Slack adapter: Socket Mode by default or the HTTP Events API, with Block Kit messages."
      },
      "category": "adapter"
    }
  }
}
