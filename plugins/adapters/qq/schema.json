{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "websocket",
        "webhook",
        "middleware"
      ],
      "default": "websocket",
      "description": "WebSocket gateway (default). webhook/middleware use httpHostToken POST."
    },
    "sandbox": {
      "type": "boolean",
      "default": false
    },
    "botKind": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "description": "公域/私域：均含 GROUP_AND_C2C_EVENT；频道消息分别为 PUBLIC_GUILD_MESSAGES / GUILD_MESSAGES。未显式配置 intents 时按此展开",
      "x-i18n": {
        "en": {
          "description": "Public/private bot type. Both include GROUP_AND_C2C_EVENT; channel messages use PUBLIC_GUILD_MESSAGES or GUILD_MESSAGES respectively. Used to derive intents when they are not explicitly configured."
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "description": "平台身份 → zhin 聊天角色的映射规则（ADR 0056 §4）。结果只作用于消息所在会话、按平台身份实时计算；适配器层规则对其所有账号有效，账号层（endpoints[i].roles）追加或覆盖同 match 的规则。默认规则：standing 为 owner / admin → 会话 admin。",
      "x-i18n": {
        "en": {
          "description": "Platform identity → zhin chat role mapping rules (ADR 0056 §4). Results apply only to the conversation of the message and are computed live from the platform identity; adapter-level rules cover every account, account-level rules (endpoints[i].roles) add to or override rules with the same match. Default rule: standing owner / admin → conversation admin."
        }
      },
      "properties": {
        "inherit": {
          "type": "boolean",
          "default": true,
          "description": "false 时丢弃上级（含默认规则）的映射规则",
          "x-i18n": {
            "en": {
              "description": "false drops the rules from the levels above, the default rule included."
            }
          }
        },
        "mappings": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "description": "映射规则列表；配置文件中只能授予 admin（或 none 取消上级同 match 规则），trusted / owner 只能在会话层（Console 或聊天）显式设置",
          "x-i18n": {
            "en": {
              "description": "Mapping rules. The configuration file can grant only admin (or none, which removes an inherited rule with the same match); trusted / owner mappings exist only at the conversation level (Console or chat)."
            }
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "grant"
            ],
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": false,
                "description": "给出的条件全部满足；每个条件内任一值满足即可",
                "x-i18n": {
                  "en": {
                    "description": "Every given criterion must hold; any value within one criterion matches."
                  }
                },
                "properties": {
                  "standing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "admin",
                        "member",
                        "guest"
                      ]
                    },
                    "minItems": 1,
                    "description": "平台归一地位",
                    "x-i18n": {
                      "en": {
                        "description": "Normalized platform standing."
                      }
                    }
                  },
                  "role": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "平台角色 id",
                    "x-i18n": {
                      "en": {
                        "description": "Platform role ids."
                      }
                    }
                  },
                  "permission": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "平台权限名",
                    "x-i18n": {
                      "en": {
                        "description": "Platform permission names."
                      }
                    }
                  }
                }
              },
              "grant": {
                "type": "string",
                "enum": [
                  "admin",
                  "none"
                ],
                "description": "授予的会话角色；none 取消上级同 match 的规则",
                "x-i18n": {
                  "en": {
                    "description": "Conversation role granted; none removes an inherited rule with the same match."
                  }
                }
              }
            }
          }
        }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "WebSocket Identify intents；省略时按 botKind 自动生成（public→含 PUBLIC_GUILD_MESSAGES）",
      "x-i18n": {
        "en": {
          "description": "WebSocket Identify intents. When omitted, derived from botKind; public includes PUBLIC_GUILD_MESSAGES."
        }
      }
    },
    "accessTokenUrl": {
      "type": "string"
    },
    "gatewayUrl": {
      "type": "string"
    },
    "webhookPath": {
      "type": "string",
      "default": "/qq/webhook",
      "description": "POST path on httpHostToken for webhook/middleware modes."
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：每项定义一个 endpoint，id/appid/secret 必填，其余字段覆盖实例默认值",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "appid": {
            "type": "string",
            "description": "QQ official bot app ID"
          },
          "secret": {
            "type": "string",
            "description": "QQ official bot secret"
          },
          "mode": {
            "type": "string",
            "enum": [
              "websocket",
              "webhook",
              "middleware"
            ]
          },
          "sandbox": {
            "type": "boolean"
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "description": "本账号的映射规则；追加或覆盖适配器层同 match 的规则（ADR 0056 §4）",
            "x-i18n": {
              "en": {
                "description": "Mapping rules of this account; add to or override adapter-level rules with the same match (ADR 0056 §4)."
              }
            },
            "properties": {
              "inherit": {
                "type": "boolean",
                "default": true,
                "description": "false 时丢弃上级（含默认规则）的映射规则",
                "x-i18n": {
                  "en": {
                    "description": "false drops the rules from the levels above, the default rule included."
                  }
                }
              },
              "mappings": {
                "type": "array",
                "maxItems": 64,
                "default": [],
                "description": "映射规则列表；配置文件中只能授予 admin（或 none 取消上级同 match 规则），trusted / owner 只能在会话层（Console 或聊天）显式设置",
                "x-i18n": {
                  "en": {
                    "description": "Mapping rules. The configuration file can grant only admin (or none, which removes an inherited rule with the same match); trusted / owner mappings exist only at the conversation level (Console or chat)."
                  }
                },
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "match",
                    "grant"
                  ],
                  "properties": {
                    "match": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "给出的条件全部满足；每个条件内任一值满足即可",
                      "x-i18n": {
                        "en": {
                          "description": "Every given criterion must hold; any value within one criterion matches."
                        }
                      },
                      "properties": {
                        "standing": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "owner",
                              "admin",
                              "member",
                              "guest"
                            ]
                          },
                          "minItems": 1,
                          "description": "平台归一地位",
                          "x-i18n": {
                            "en": {
                              "description": "Normalized platform standing."
                            }
                          }
                        },
                        "role": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "description": "平台角色 id",
                          "x-i18n": {
                            "en": {
                              "description": "Platform role ids."
                            }
                          }
                        },
                        "permission": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "description": "平台权限名",
                          "x-i18n": {
                            "en": {
                              "description": "Platform permission names."
                            }
                          }
                        }
                      }
                    },
                    "grant": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "none"
                      ],
                      "description": "授予的会话角色；none 取消上级同 match 的规则",
                      "x-i18n": {
                        "en": {
                          "description": "Conversation role granted; none removes an inherited rule with the same match."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "botKind": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ],
            "description": "覆盖顶层 botKind（公域/私域），用于按 endpoint 生成 intents",
            "x-i18n": {
              "en": {
                "description": "Override top-level botKind (public/private) when deriving this endpoint's intents."
              }
            }
          },
          "intents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "覆盖顶层 intents",
            "x-i18n": {
              "en": {
                "description": "Override top-level intents."
              }
            }
          },
          "accessTokenUrl": {
            "type": "string"
          },
          "gatewayUrl": {
            "type": "string"
          },
          "webhookPath": {
            "type": "string"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "QQ bot name"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "serverName"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Optional fixed loopback TCP fault proxy for WSS only; original gateway TLS identity must match serverName."
          },
          "notify": {
            "type": "object",
            "additionalProperties": false,
            "description": "掉线/登录失败时通过另一个适配器实例给 master 发通知（adapter/endpoint/kind/id 指向实际会话）",
            "x-i18n": {
              "en": {
                "description": "Send outage/login notices to the master through another adapter instance (adapter/endpoint/kind/id identify the actual conversation)."
              }
            },
            "properties": {
              "adapter": {
                "type": "string",
                "description": "通知使用的适配器类型，如 qq / icqq",
                "x-i18n": {
                  "en": {
                    "description": "Adapter type used for the notice, such as qq or icqq."
                  }
                }
              },
              "endpoint": {
                "type": "string",
                "description": "该适配器的 endpoint id",
                "x-i18n": {
                  "en": {
                    "description": "Endpoint id of that adapter."
                  }
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "private",
                  "group",
                  "channel"
                ],
                "default": "private",
                "description": "会话类型，默认 private",
                "x-i18n": {
                  "en": {
                    "description": "Conversation kind; defaults to private."
                  }
                }
              },
              "id": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "master 在该平台上的会话 id（QQ 官方为 openid，ICQQ 为 QQ 号）",
                "x-i18n": {
                  "en": {
                    "description": "Master conversation id on that platform (openid for QQ official, QQ number for ICQQ)."
                  }
                }
              },
              "parent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "private",
                      "group",
                      "channel"
                    ]
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "description": "可选的父频道/群容器"
              }
            },
            "required": [
              "adapter",
              "endpoint",
              "id"
            ]
          },
          "streaming": {
            "type": "boolean",
            "description": "在支持的会话中渐进发送回复。设为 false 时仅发送完整回复。",
            "x-i18n": {
              "en": {
                "description": "Publish supported replies while generating. Set false to send only complete replies."
              }
            }
          },
          "streamingIntervalMs": {
            "type": "number",
            "minimum": 0,
            "description": "后续回复更新的最小间隔（毫秒）；首段立即发送。",
            "x-i18n": {
              "en": {
                "description": "Minimum delay in milliseconds between reply updates; the first update is immediate."
              }
            }
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          }
        },
        "required": [
          "id",
          "appid",
          "secret"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: each entry defines an endpoint. id, appid and secret are required; other fields override instance defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "streamProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "serverName"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Optional fixed loopback TCP fault proxy for WSS only; original gateway TLS identity must match serverName."
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "description": "掉线/登录失败时通过另一个适配器实例给 master 发通知（adapter/endpoint/kind/id 指向实际会话）",
      "x-i18n": {
        "en": {
          "description": "Send outage/login notices to the master through another adapter instance (adapter/endpoint/kind/id identify the actual conversation)."
        }
      },
      "properties": {
        "adapter": {
          "type": "string",
          "description": "通知使用的适配器类型，如 qq / icqq",
          "x-i18n": {
            "en": {
              "description": "Adapter type used for the notice, such as qq or icqq."
            }
          }
        },
        "endpoint": {
          "type": "string",
          "description": "该适配器的 endpoint id",
          "x-i18n": {
            "en": {
              "description": "Endpoint id of that adapter."
            }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "private",
            "group",
            "channel"
          ],
          "default": "private",
          "description": "会话类型，默认 private",
          "x-i18n": {
            "en": {
              "description": "Conversation kind; defaults to private."
            }
          }
        },
        "id": {
          "type": [
            "string",
            "number"
          ],
          "description": "master 在该平台上的会话 id（QQ 官方为 openid，ICQQ 为 QQ 号）",
          "x-i18n": {
            "en": {
              "description": "Master conversation id on that platform (openid for QQ official, QQ number for ICQQ)."
            }
          }
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "private",
                "group",
                "channel"
              ]
            },
            "id": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "可选的父频道/群容器"
        }
      },
      "required": [
        "adapter",
        "endpoint",
        "id"
      ]
    },
    "streaming": {
      "type": "boolean",
      "default": true,
      "description": "在支持的会话中渐进发送回复。设为 false 时仅发送完整回复。",
      "x-i18n": {
        "en": {
          "description": "Publish supported replies while generating. Set false to send only complete replies."
        }
      }
    },
    "streamingIntervalMs": {
      "type": "number",
      "minimum": 0,
      "default": 500,
      "description": "后续回复更新的最小间隔（毫秒）；首段立即发送。",
      "x-i18n": {
        "en": {
          "description": "Minimum delay in milliseconds between reply updates; the first update is immediate."
        }
      }
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
