{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "websocket",
        "webhook",
        "middleware"
      ],
      "default": "websocket",
      "description": "WebSocket gateway (default). webhook/middleware use httpHostToken POST."
    },
    "sandbox": {
      "type": "boolean",
      "default": false
    },
    "botKind": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "description": "公域/私域：均含 GROUP_AND_C2C_EVENT；频道消息分别为 PUBLIC_GUILD_MESSAGES / GUILD_MESSAGES。未显式配置 intents 时按此展开",
      "x-i18n": {
        "en": {
          "description": "Public/private bot type. Both include GROUP_AND_C2C_EVENT; channel messages use PUBLIC_GUILD_MESSAGES or GUILD_MESSAGES respectively. Used to derive intents when they are not explicitly configured."
        }
      }
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（endpoint 管理命令、AI/工具权限）；openid。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (openid) for endpoint management and AI/tool permissions. endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted openid"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "WebSocket Identify intents；省略时按 botKind 自动生成（public→含 PUBLIC_GUILD_MESSAGES）",
      "x-i18n": {
        "en": {
          "description": "WebSocket Identify intents. When omitted, derived from botKind; public includes PUBLIC_GUILD_MESSAGES."
        }
      }
    },
    "accessTokenUrl": {
      "type": "string"
    },
    "gatewayUrl": {
      "type": "string"
    },
    "webhookPath": {
      "type": "string",
      "default": "/qq/webhook",
      "description": "POST path on httpHostToken for webhook/middleware modes."
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：每项定义一个 endpoint，id/appid/secret 必填，其余字段覆盖实例默认值",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "appid": {
            "type": "string",
            "description": "QQ official bot app ID"
          },
          "secret": {
            "type": "string",
            "description": "QQ official bot secret"
          },
          "mode": {
            "type": "string",
            "enum": [
              "websocket",
              "webhook",
              "middleware"
            ]
          },
          "sandbox": {
            "type": "boolean"
          },
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（openid）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (openid), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted openid"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "botKind": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ],
            "description": "覆盖顶层 botKind（公域/私域），用于按 endpoint 生成 intents",
            "x-i18n": {
              "en": {
                "description": "Override top-level botKind (public/private) when deriving this endpoint's intents."
              }
            }
          },
          "intents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "覆盖顶层 intents",
            "x-i18n": {
              "en": {
                "description": "Override top-level intents."
              }
            }
          },
          "accessTokenUrl": {
            "type": "string"
          },
          "gatewayUrl": {
            "type": "string"
          },
          "webhookPath": {
            "type": "string"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "QQ bot name"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "serverName"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Optional fixed loopback TCP fault proxy for WSS only; original gateway TLS identity must match serverName."
          },
          "notify": {
            "type": "object",
            "additionalProperties": false,
            "description": "掉线/登录失败时通过另一个适配器实例给 master 发通知（adapter/endpoint/kind/id 指向实际会话）",
            "x-i18n": {
              "en": {
                "description": "Send outage/login notices to the master through another adapter instance (adapter/endpoint/kind/id identify the actual conversation)."
              }
            },
            "properties": {
              "adapter": {
                "type": "string",
                "description": "通知使用的适配器类型，如 qq / icqq",
                "x-i18n": {
                  "en": {
                    "description": "Adapter type used for the notice, such as qq or icqq."
                  }
                }
              },
              "endpoint": {
                "type": "string",
                "description": "该适配器的 endpoint id",
                "x-i18n": {
                  "en": {
                    "description": "Endpoint id of that adapter."
                  }
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "private",
                  "group",
                  "channel"
                ],
                "default": "private",
                "description": "会话类型，默认 private",
                "x-i18n": {
                  "en": {
                    "description": "Conversation kind; defaults to private."
                  }
                }
              },
              "id": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "master 在该平台上的会话 id（QQ 官方为 openid，ICQQ 为 QQ 号）",
                "x-i18n": {
                  "en": {
                    "description": "Master conversation id on that platform (openid for QQ official, QQ number for ICQQ)."
                  }
                }
              },
              "parent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "private",
                      "group",
                      "channel"
                    ]
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "description": "可选的父频道/群容器"
              }
            },
            "required": [
              "adapter",
              "endpoint",
              "id"
            ]
          }
        },
        "required": [
          "id",
          "appid",
          "secret"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: each entry defines an endpoint. id, appid and secret are required; other fields override instance defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "streamProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "serverName"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Optional fixed loopback TCP fault proxy for WSS only; original gateway TLS identity must match serverName."
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "description": "掉线/登录失败时通过另一个适配器实例给 master 发通知（adapter/endpoint/kind/id 指向实际会话）",
      "x-i18n": {
        "en": {
          "description": "Send outage/login notices to the master through another adapter instance (adapter/endpoint/kind/id identify the actual conversation)."
        }
      },
      "properties": {
        "adapter": {
          "type": "string",
          "description": "通知使用的适配器类型，如 qq / icqq",
          "x-i18n": {
            "en": {
              "description": "Adapter type used for the notice, such as qq or icqq."
            }
          }
        },
        "endpoint": {
          "type": "string",
          "description": "该适配器的 endpoint id",
          "x-i18n": {
            "en": {
              "description": "Endpoint id of that adapter."
            }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "private",
            "group",
            "channel"
          ],
          "default": "private",
          "description": "会话类型，默认 private",
          "x-i18n": {
            "en": {
              "description": "Conversation kind; defaults to private."
            }
          }
        },
        "id": {
          "type": [
            "string",
            "number"
          ],
          "description": "master 在该平台上的会话 id（QQ 官方为 openid，ICQQ 为 QQ 号）",
          "x-i18n": {
            "en": {
              "description": "Master conversation id on that platform (openid for QQ official, QQ number for ICQQ)."
            }
          }
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "private",
                "group",
                "channel"
              ]
            },
            "id": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "可选的父频道/群容器"
        }
      },
      "required": [
        "adapter",
        "endpoint",
        "id"
      ]
    }
  },
  "required": [
    "endpoints"
  ]
}
