{
  "name": "@zhin.js/adapter-ipad-wechat",
  "version": "0.0.4",
  "type": "module",
  "description": "iPad WeChat adapter: personal WeChat through the @wchats/ipad SDK (iPad protocol, local signing) — private and group text, images and mentions.",
  "keywords": [
    "zhin.js",
    "wechat",
    "weixin",
    "ipad"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/ipad-wechat/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/zhinjs/zhin.git",
    "type": "git",
    "directory": "plugins/adapters/ipad-wechat"
  },
  "files": [
    "lib",
    "plugin.js",
    "schema.json",
    "adapters",
    "!adapters/**/*.ts",
    "pages",
    "!pages/**/*.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "dependencies": {
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*"
  },
  "peerDependencies": {
    "@wchats/ipad": "0.0.1",
    "@wchats/ipad-sign": "0.0.1",
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@wchats/ipad": {
      "optional": true
    },
    "@wchats/ipad-sign": {
      "optional": true
    },
    "zhin.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@wchats/ipad": "0.0.1",
    "@wchats/ipad-sign": "0.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "iPad WeChat Adapter",
      "displayNameI18n": {
        "zh-CN": "微信 iPad 适配器",
        "en": "iPad WeChat Adapter"
      },
      "descriptionI18n": {
        "zh-CN": "通过 @wchats/ipad SDK（iPad 协议、本地签名）接入个人微信：私聊、群聊的文本、图片与 @。",
        "en": "Personal WeChat through the @wchats/ipad SDK (iPad protocol, local signing): private and group text, images and mentions."
      },
      "category": "adapter"
    }
  }
}
