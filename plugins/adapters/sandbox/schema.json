{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "streaming": {
      "type": "boolean",
      "default": true,
      "description": "Publish supported replies while generating. Set false to send only complete replies."
    },
    "streamingIntervalMs": {
      "type": "number",
      "minimum": 0,
      "default": 500,
      "description": "Minimum delay in milliseconds between reply updates; the first update is immediate."
    },
    "endpoints": {
      "type": "array",
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "description": "Sandbox owner user ID"
          },
          "streaming": {
            "type": "boolean",
            "description": "Publish supported replies while generating. Set false to send only complete replies."
          },
          "streamingIntervalMs": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum delay in milliseconds between reply updates; the first update is immediate."
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Sandbox bot name"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          },
          "media": {
            "$ref": "#/$defs/media",
            "description": "Sandbox 托管的本地上传（图片、语音、文件）：大小上限、配额、链接有效期、公开下载",
            "x-i18n": {
              "en": {
                "description": "Sandbox-hosted local uploads (images, voice, files): size limits, quotas, link lifetime, public download"
              }
            }
          }
        },
        "required": [
          "id"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    },
    "media": {
      "$ref": "#/$defs/media",
      "description": "Sandbox 托管的本地上传（图片、语音、文件）：大小上限、配额、链接有效期、公开下载",
      "x-i18n": {
        "en": {
          "description": "Sandbox-hosted local uploads (images, voice, files): size limits, quotas, link lifetime, public download"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "default": 24,
          "description": "签名链接与文件的有效期（小时，1–168）；到期前可删除文件来撤销",
          "x-i18n": {
            "en": {
              "description": "Lifetime of signed links and files in hours (1–168); delete a file to revoke it earlier"
            }
          }
        },
        "publicDownload": {
          "type": "boolean",
          "default": false,
          "description": "开放 /pub/sandbox-media 签名下载（等于生成限时外链，仍需有效签名）。默认关闭",
          "x-i18n": {
            "en": {
              "description": "Open signed downloads under /pub/sandbox-media (time-limited external links; a valid signature is still required). Off by default"
            }
          }
        },
        "maxBytes": {
          "type": "object",
          "additionalProperties": false,
          "description": "单个文件按类型的字节上限；硬顶 64 MiB（网关请求体上限），更大需同时调整网关配置",
          "x-i18n": {
            "en": {
              "description": "Per-type byte limit of one file; hard ceiling 64 MiB (the gateway's request body limit); larger needs the gateway raised too"
            }
          },
          "properties": {
            "image": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864,
              "default": 10485760,
              "description": "图片",
              "x-i18n": {
                "en": {
                  "description": "Images"
                }
              }
            },
            "audio": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864,
              "default": 20971520,
              "description": "语音 / 音频",
              "x-i18n": {
                "en": {
                  "description": "Voice / audio"
                }
              }
            },
            "video": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864,
              "default": 33554432,
              "description": "视频",
              "x-i18n": {
                "en": {
                  "description": "Video"
                }
              }
            },
            "file": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864,
              "default": 33554432,
              "description": "其他文件",
              "x-i18n": {
                "en": {
                  "description": "Other files"
                }
              }
            }
          }
        },
        "uploaderQuotaBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120,
          "default": 209715200,
          "description": "每个上传者在本端点可占用的字节数；超出时拒绝上传，不淘汰他人文件",
          "x-i18n": {
            "en": {
              "description": "Bytes one uploader may hold on this endpoint; over it uploads are refused, nobody else's files are evicted"
            }
          }
        },
        "quotaBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120,
          "default": 524288000,
          "description": "本端点的总配额；超出时拒绝上传",
          "x-i18n": {
            "en": {
              "description": "Total quota of this endpoint; over it uploads are refused"
            }
          }
        }
      }
    }
  }
}
