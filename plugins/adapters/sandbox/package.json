{
  "name": "@zhin.js/adapter-sandbox",
  "version": "1.1.33",
  "description": "Sandbox adapter: a local chat workspace for the Remote Console, for development and testing without a real platform.",
  "keywords": [
    "zhin.js",
    "sandbox",
    "testing",
    "development"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "adapters",
    "pages",
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/zhinjs/zhin.git",
    "type": "git",
    "directory": "plugins/adapters/sandbox"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/sandbox/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/client": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/host-http": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "lucide-react": "^0.525.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "@zhin.js/pagemanager": "workspace:*",
    "@zhin.js/runtime": "workspace:*",
    "react": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.1",
    "zhin.js": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/console-contract": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "@zhin.js/host-http": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "react": "^19.0.0",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Sandbox Adapter",
      "displayNameI18n": {
        "zh-CN": "沙盒适配器",
        "en": "Sandbox Adapter"
      },
      "descriptionI18n": {
        "zh-CN": "沙盒适配器：为 Remote Console 提供本地会话工作区，用于开发和测试，无需接入真实平台。",
        "en": "Sandbox adapter: a local chat workspace for the Remote Console, for development and testing without a real platform."
      },
      "category": "adapter"
    }
  }
}
