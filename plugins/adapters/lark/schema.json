{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "webhookPath": {
      "type": "string",
      "default": "/lark/webhook"
    },
    "apiBaseUrl": {
      "type": "string"
    },
    "isFeishu": {
      "type": "boolean",
      "default": true
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（Lark/Feishu open_id or user_id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖"
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted Lark/Feishu open_id or user_id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加"
    },
    "endpoints": {
      "type": "array",
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（name 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Lark bot name"
          },
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（Lark/Feishu open_id or user_id）；覆盖顶层 master"
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted Lark/Feishu open_id or user_id"
            },
            "description": "本 endpoint 的 trusted 列表"
          },
          "appId": {
            "type": "string",
            "description": "Lark app ID"
          },
          "appSecret": {
            "type": "string",
            "description": "Lark app secret"
          },
          "encryptKey": {
            "type": "string",
            "description": "Lark encrypt key"
          },
          "verificationToken": {
            "type": "string",
            "description": "Lark verification token"
          }
        },
        "required": [
          "name",
          "appId",
          "appSecret"
        ]
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖"
    }
  },
  "required": [
    "endpoints"
  ]
}
