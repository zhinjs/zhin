{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "webhookPath": {
      "type": "string",
      "default": "/lark/webhook"
    },
    "apiBaseUrl": {
      "type": "string"
    },
    "isFeishu": {
      "type": "boolean",
      "default": true
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（Lark/Feishu open_id or user_id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (Lark/Feishu open_id or user_id; AI/tool permissions and endpoint management). endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted Lark/Feishu open_id or user_id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（Lark/Feishu open_id or user_id）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (Lark/Feishu open_id or user_id), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted Lark/Feishu open_id or user_id"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "appId": {
            "type": "string",
            "description": "Lark app ID"
          },
          "appSecret": {
            "type": "string",
            "description": "Lark app secret"
          },
          "encryptKey": {
            "type": "string",
            "description": "Lark encrypt key"
          },
          "verificationToken": {
            "type": "string",
            "description": "Lark verification token"
          },
          "webhookPath": {
            "type": "string"
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "isFeishu": {
            "type": "boolean"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Lark bot name"
          },
          "mode": {
            "type": "string",
            "enum": [
              "webhook",
              "websocket"
            ],
            "default": "webhook"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$"
              }
            },
            "required": [
              "port",
              "serverName"
            ],
            "description": "WSS故障验收：仅TCP固定loopback，保留TLS身份",
            "x-i18n": {
              "en": {
                "description": "WSS fault-injection tests: pin only TCP to loopback while preserving TLS identity."
              }
            }
          },
          "webApiProxy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "description": "默认关闭；仅飞书出站API的loopback TLS故障代理，保留官方Host/SNI和证书校验，与streamProxy独立",
            "x-i18n": {
              "en": {
                "description": "Disabled by default. Loopback TLS fault proxy for Feishu outbound APIs only; preserves the official Host, SNI and certificate validation. Independent of streamProxy."
              }
            }
          }
        },
        "required": [
          "id",
          "appId",
          "appSecret"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "webhook",
        "websocket"
      ],
      "default": "webhook"
    },
    "webApiProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "description": "默认关闭；仅飞书出站API的loopback TLS故障代理，保留官方Host/SNI和证书校验，与streamProxy独立",
      "x-i18n": {
        "en": {
          "description": "Disabled by default. Loopback TLS fault proxy for Feishu outbound APIs only; preserves the official Host, SNI and certificate validation. Independent of streamProxy."
        }
      }
    }
  },
  "required": [
    "endpoints"
  ]
}
