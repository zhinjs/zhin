{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "smtp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "secure": {
                "type": "boolean"
              },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "user": {
                    "type": "string"
                  },
                  "pass": {
                    "type": "string"
                  }
                },
                "required": [
                  "user",
                  "pass"
                ]
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$",
                "description": "TLS SNI 与证书主机名校验，代理场景保留原服务域名；不改变证书校验策略",
                "x-i18n": {
                  "en": {
                    "description": "TLS SNI and certificate hostname verification. Preserve the original service hostname when using a proxy; does not change certificate validation policy."
                  }
                }
              }
            },
            "required": [
              "host",
              "port",
              "secure",
              "auth"
            ]
          },
          "imap": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "tls": {
                "type": "boolean"
              },
              "user": {
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "checkInterval": {
                "type": "number",
                "default": 60000
              },
              "reconnectInterval": {
                "type": "number",
                "default": 5000
              },
              "mailbox": {
                "type": "string",
                "default": "INBOX"
              },
              "markSeen": {
                "type": "boolean",
                "default": true
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$",
                "description": "TLS SNI 与证书主机名校验，代理场景保留原服务域名；不改变证书校验策略",
                "x-i18n": {
                  "en": {
                    "description": "TLS SNI and certificate hostname verification. Preserve the original service hostname when using a proxy; does not change certificate validation policy."
                  }
                }
              }
            },
            "required": [
              "host",
              "port",
              "tls",
              "user",
              "password"
            ]
          },
          "attachments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "downloadPath": {
                "type": "string"
              },
              "maxFileSize": {
                "type": "number"
              },
              "allowedTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Email bot name"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          }
        },
        "required": [
          "id",
          "smtp",
          "imap"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
