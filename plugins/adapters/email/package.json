{
  "name": "@zhin.js/adapter-email",
  "version": "1.1.29",
  "type": "module",
  "description": "Email adapter: sends over SMTP and polls IMAP, turning a mailbox into a chat channel.",
  "keywords": [
    "zhin.js",
    "email",
    "smtp",
    "imap"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/email/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "imap": "^0.8.19",
    "mailparser": "^3.9.14",
    "nodemailer": "^10.1.4"
  },
  "peerDependencies": {
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "zhin.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/imap": "^0.8.43",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/zhinjs/zhin.git",
    "type": "git",
    "directory": "plugins/adapters/email"
  },
  "files": [
    "adapters",
    "pages",
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Email Adapter",
      "displayNameI18n": {
        "zh-CN": "邮件适配器",
        "en": "Email Adapter"
      },
      "descriptionI18n": {
        "zh-CN": "邮件适配器：通过 SMTP 发信、IMAP 轮询收信，把邮箱作为聊天通道接入。",
        "en": "Email adapter: sends over SMTP and polls IMAP, turning a mailbox into a chat channel."
      },
      "category": "adapter"
    }
  }
}
