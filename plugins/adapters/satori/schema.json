{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connection": {
      "type": "string",
      "enum": [
        "ws",
        "webhook"
      ],
      "default": "ws",
      "description": "ws (default) or webhook (httpHostToken POST route)"
    },
    "heartbeat_interval": {
      "type": "number",
      "default": 10000,
      "description": "WS PING interval in milliseconds"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（platform user id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (platform user id; AI/tool permissions and endpoint management). endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted platform user id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：每项明确选择 platform/userId，id/baseUrl 必填，其余字段覆盖实例默认值",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（platform user id）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (platform user id), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted platform user id"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "baseUrl": {
            "type": "string",
            "description": "Satori SDK HTTP/WS base URL (e.g. http://127.0.0.1:5140)"
          },
          "connection": {
            "type": "string",
            "enum": [
              "ws",
              "webhook"
            ]
          },
          "token": {
            "type": "string",
            "description": "Bearer token for API and WS IDENTIFY"
          },
          "path": {
            "type": "string",
            "description": "Webhook POST path (connection: webhook)"
          },
          "heartbeat_interval": {
            "type": "number"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Satori bot name"
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "description": "Selected Satori login platform"
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "description": "Selected Satori login user ID"
          }
        },
        "required": [
          "id",
          "baseUrl",
          "platform",
          "userId"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: each entry selects an explicit platform and userId. id and baseUrl are required; remaining fields override instance defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    }
  },
  "required": [
    "endpoints"
  ]
}
