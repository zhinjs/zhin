{
  "name": "@zhin.js/adapter-juejin",
  "version": "0.1.9",
  "description": "Juejin comment adapter (experimental): AI-assisted replies to comments on your own Juejin articles, with Console review before sending.",
  "keywords": [
    "zhin.js",
    "juejin",
    "掘金",
    "comments",
    "review"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/zhinjs/zhin.git",
    "type": "git",
    "directory": "plugins/adapters/juejin"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/juejin/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "zhin.js": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/page": "workspace:^"
  },
  "peerDependenciesMeta": {
    "zhin.js": {
      "optional": true
    },
    "@zhin.js/command": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@zhin.js/pagemanager": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "files": [
    "adapters",
    "commands",
    "pages",
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Juejin Comment Adapter (Experimental)",
      "displayNameI18n": {
        "zh-CN": "掘金评论适配器（实验性）",
        "en": "Juejin Comment Adapter (Experimental)"
      },
      "descriptionI18n": {
        "zh-CN": "掘金评论适配器（实验性）：AI 辅助回复你自己的掘金文章评论，发送前可在 Console 审批。",
        "en": "Juejin comment adapter (experimental): AI-assisted replies to comments on your own Juejin articles, with Console review before sending."
      },
      "category": "adapter"
    }
  }
}
