{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiBaseUrl": {
      "type": "string",
      "default": "https://oapi.dingtalk.com"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（DingTalk userid；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (DingTalk userid; AI/tool permissions and endpoint management). endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted DingTalk userid"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（DingTalk userid）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (DingTalk userid), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted DingTalk userid"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "appKey": {
            "type": "string",
            "description": "Dingtalk app key"
          },
          "appSecret": {
            "type": "string",
            "description": "Dingtalk app secret"
          },
          "webhookPath": {
            "type": "string",
            "description": "Dingtalk webhook path"
          },
          "robotCode": {
            "type": "string",
            "description": "Dingtalk robot code"
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Dingtalk bot name"
          },
          "mode": {
            "type": "string",
            "enum": [
              "webhook",
              "stream"
            ],
            "default": "webhook"
          },
          "cardTemplateId": {
            "type": "string",
            "minLength": 1,
            "description": "Stream interactive card template ID"
          },
          "cardButtonCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2,
            "description": "Fixed button count in the card template"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$"
              }
            },
            "required": [
              "port",
              "serverName"
            ],
            "description": "故障验收专用：TCP固定127.0.0.1，保留真实WSS TLS身份",
            "x-i18n": {
              "en": {
                "description": "Fault-injection tests only: pin TCP to 127.0.0.1 while preserving the actual WSS TLS identity."
              }
            }
          }
        },
        "required": [
          "id",
          "appKey",
          "appSecret"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "webhook",
        "stream"
      ],
      "default": "webhook"
    },
    "cardTemplateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stream interactive card template ID"
    },
    "cardButtonCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "description": "Fixed button count in the card template"
    }
  },
  "required": [
    "endpoints"
  ]
}
