{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "polling": {
      "type": "boolean",
      "default": true,
      "description": "Long-poll getUpdates (default). Set false for webhook via httpHostToken."
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "description": "Webhook settings when polling is false.",
      "properties": {
        "domain": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "default": "/telegram/webhook"
        },
        "secretToken": {
          "type": "string",
          "description": "Verified via X-Telegram-Bot-Api-Secret-Token."
        }
      }
    },
    "allowedUpdates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "message",
        "callback_query"
      ]
    },
    "apiBaseUrl": {
      "type": "string",
      "default": "https://api.telegram.org"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（Telegram user id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (Telegram user id; AI/tool permissions and endpoint management). endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted Telegram user id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（Telegram user id）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (Telegram user id), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted Telegram user id"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "token": {
            "type": "string",
            "description": "Telegram bot token"
          },
          "polling": {
            "type": "boolean"
          },
          "webhook": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "secretToken": {
                "type": "string"
              }
            }
          },
          "allowedUpdates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Telegram bot name"
          }
        },
        "required": [
          "id",
          "token"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    }
  },
  "required": [
    "endpoints"
  ]
}
