{
  "name": "@zhin.js/adapter-github",
  "version": "1.1.29",
  "description": "GitHub adapter: Issue and PR comment threads as chat channels, GitHub App auth and webhook events.",
  "keywords": [
    "zhin.js",
    "github",
    "issues",
    "pull-requests",
    "webhook"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./gh-client": {
      "types": "./lib/gh-client.d.ts",
      "development": "./src/gh-client.ts",
      "import": "./lib/gh-client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/adapters/github"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/github/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/agent-feature": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/host-http": "workspace:*",
    "@zhin.js/host-http-contract": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/agent": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "@zhin.js/host-http": "workspace:^",
    "@zhin.js/prompt-section": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/agent": {
      "optional": true
    },
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/prompt-section": {
      "optional": true
    },
    "zhin.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@zhin.js/agent": "workspace:*",
    "@zhin.js/prompt-section": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "files": [
    "adapters",
    "commands",
    "pages",
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "agents",
    "README.md",
    "CHANGELOG.md",
    "prompt-sections"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./gh-client": {
        "types": "./lib/gh-client.d.ts",
        "import": "./lib/gh-client.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.1.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/agent-feature",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/prompt-section",
        "api": "^1.0.0",
        "optional": true
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "GitHub Adapter",
      "displayNameI18n": {
        "zh-CN": "GitHub 适配器",
        "en": "GitHub Adapter"
      },
      "descriptionI18n": {
        "zh-CN": "GitHub 适配器：把 Issue / PR 评论区作为聊天通道，GitHub App 认证，Webhook 入站。",
        "en": "GitHub adapter: Issue and PR comment threads as chat channels, GitHub App auth and webhook events."
      },
      "category": "adapter"
    }
  }
}
