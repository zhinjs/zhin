{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": {
      "type": "string",
      "description": "GitHub Enterprise hostname (default github.com)"
    },
    "webhook_path": {
      "type": "string",
      "default": "/github/webhook"
    },
    "auto_reply_repos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Repos whose Issue/PR comments auto-trigger AI without @bot"
    },
    "bot_login": {
      "type": "string",
      "description": "Override App bot login (default {slug}[bot])"
    },
    "workspace_root": {
      "type": "string",
      "description": "Managed git workspace root"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "type": [
              "string",
              "number"
            ],
            "description": "GitHub App ID"
          },
          "private_key": {
            "type": "string",
            "description": "GitHub App private key (PEM content or file path)"
          },
          "webhook_secret": {
            "type": "string",
            "description": "Webhook HMAC secret; enables httpHostToken POST route"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "GitHub App bot name"
          },
          "host": {
            "type": "string",
            "description": "GitHub Enterprise hostname"
          },
          "webhook_path": {
            "type": "string",
            "description": "Webhook route path"
          },
          "auto_reply_repos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Repos whose comments auto-trigger AI"
          },
          "bot_login": {
            "type": "string",
            "description": "Override App bot login"
          },
          "workspace_root": {
            "type": "string",
            "description": "Managed git workspace root"
          },
          "commandPrefix": {
            "type": "string",
            "description": "本 endpoint 的命令前缀",
            "x-i18n": {
              "en": {
                "description": "Command prefix for this endpoint."
              }
            }
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          }
        },
        "required": [
          "id",
          "app_id",
          "private_key"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
