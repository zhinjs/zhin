{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roomId": {
      "type": [
        "string",
        "number"
      ],
      "description": "直播间号（短号或长号都可以）；只填你自己的直播间",
      "x-i18n": {
        "en": {
          "description": "Live room id (short or full); use your own room only."
        }
      }
    },
    "sendMode": {
      "type": "string",
      "enum": [
        "direct",
        "off"
      ],
      "default": "direct",
      "description": "出站模式：direct=回合结束直接发弹幕（默认，需登录）；off=只听不说",
      "x-i18n": {
        "en": {
          "description": "Outbound mode: direct (default, needs login) posts the reply as danmaku; off only listens."
        }
      }
    },
    "maxLength": {
      "type": "number",
      "minimum": 10,
      "maximum": 100,
      "default": 20,
      "description": "单条弹幕最多字符数（默认 20，直播等级高的账号可调大）",
      "x-i18n": {
        "en": {
          "description": "Maximum characters per danmaku (default 20; higher live levels allow more)."
        }
      }
    },
    "maxChunks": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "description": "一次回复最多拆成几条弹幕（默认 2），放不下的截断",
      "x-i18n": {
        "en": {
          "description": "Maximum danmaku per reply (default 2); the rest is truncated."
        }
      }
    },
    "minSendIntervalSec": {
      "type": "number",
      "minimum": 2,
      "default": 5,
      "description": "两次回复的最小间隔（秒），最小 2；不足时拒绝发送，不排队",
      "x-i18n": {
        "en": {
          "description": "Minimum seconds between two replies, at least 2; a reply sent sooner is rejected, not queued."
        }
      }
    },
    "apiBaseUrl": {
      "type": "string",
      "default": "https://api.bilibili.com"
    },
    "liveApiBaseUrl": {
      "type": "string",
      "default": "https://api.live.bilibili.com"
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "description": "平台身份 → zhin 聊天角色的映射规则（ADR 0056 §4）。结果只作用于消息所在会话、按平台身份实时计算；适配器层规则对其所有账号有效，账号层（endpoints[i].roles）追加或覆盖同 match 的规则。默认规则：standing 为 owner / admin → 会话 admin。",
      "x-i18n": {
        "en": {
          "description": "Platform identity → zhin chat role mapping rules (ADR 0056 §4). Results apply only to the conversation of the message and are computed live from the platform identity; adapter-level rules cover every account, account-level rules (endpoints[i].roles) add to or override rules with the same match. Default rule: standing owner / admin → conversation admin."
        }
      },
      "properties": {
        "inherit": {
          "type": "boolean",
          "default": true,
          "description": "false 时丢弃上级（含默认规则）的映射规则",
          "x-i18n": {
            "en": {
              "description": "false drops the rules from the levels above, the default rule included."
            }
          }
        },
        "mappings": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "description": "映射规则列表；配置文件中只能授予 admin（或 none 取消上级同 match 规则），trusted / owner 只能在会话层（Console 或聊天）显式设置",
          "x-i18n": {
            "en": {
              "description": "Mapping rules. The configuration file can grant only admin (or none, which removes an inherited rule with the same match); trusted / owner mappings exist only at the conversation level (Console or chat)."
            }
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "grant"
            ],
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": false,
                "description": "给出的条件全部满足；每个条件内任一值满足即可",
                "x-i18n": {
                  "en": {
                    "description": "Every given criterion must hold; any value within one criterion matches."
                  }
                },
                "properties": {
                  "standing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "admin",
                        "member",
                        "guest"
                      ]
                    },
                    "minItems": 1,
                    "description": "平台归一地位",
                    "x-i18n": {
                      "en": {
                        "description": "Normalized platform standing."
                      }
                    }
                  },
                  "role": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "平台角色 id",
                    "x-i18n": {
                      "en": {
                        "description": "Platform role ids."
                      }
                    }
                  },
                  "permission": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "平台权限名",
                    "x-i18n": {
                      "en": {
                        "description": "Platform permission names."
                      }
                    }
                  }
                }
              },
              "grant": {
                "type": "string",
                "enum": [
                  "admin",
                  "none"
                ],
                "description": "授予的会话角色；none 取消上级同 match 的规则",
                "x-i18n": {
                  "en": {
                    "description": "Conversation role granted; none removes an inherited rule with the same match."
                  }
                }
              }
            }
          }
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Endpoint 名称（本地标识，不是 B 站账号）",
            "x-i18n": {
              "en": {
                "description": "Local endpoint name, not a Bilibili account ID."
              }
            }
          },
          "sessdata": {
            "type": "string",
            "description": "Cookie SESSDATA（以你的账号身份发弹幕；请用 ${BILIBILI_SESSDATA} 注入，切勿写入仓库）。不填则匿名只读",
            "x-i18n": {
              "en": {
                "description": "SESSDATA cookie, acting as your account. Reference ${BILIBILI_SESSDATA}; never commit it. Omit to listen anonymously."
              }
            }
          },
          "biliJct": {
            "type": "string",
            "description": "Cookie bili_jct（csrf token，发弹幕需要；请用 ${BILIBILI_BILI_JCT} 注入）",
            "x-i18n": {
              "en": {
                "description": "bili_jct cookie (csrf token) needed to send danmaku. Reference ${BILIBILI_BILI_JCT}."
              }
            }
          },
          "buvid3": {
            "type": "string",
            "description": "Cookie buvid3（可选；不填时启动时向平台申请）",
            "x-i18n": {
              "en": {
                "description": "Optional buvid3 cookie; requested from the platform at startup when omitted."
              }
            }
          },
          "roomId": {
            "type": [
              "string",
              "number"
            ],
            "description": "直播间号（短号或长号都可以）；只填你自己的直播间",
            "x-i18n": {
              "en": {
                "description": "Live room id (short or full); use your own room only."
              }
            }
          },
          "sendMode": {
            "type": "string",
            "enum": [
              "direct",
              "off"
            ],
            "default": "direct",
            "description": "出站模式：direct=回合结束直接发弹幕（默认，需登录）；off=只听不说",
            "x-i18n": {
              "en": {
                "description": "Outbound mode: direct (default, needs login) posts the reply as danmaku; off only listens."
              }
            }
          },
          "maxLength": {
            "type": "number",
            "minimum": 10,
            "maximum": 100,
            "default": 20,
            "description": "单条弹幕最多字符数（默认 20，直播等级高的账号可调大）",
            "x-i18n": {
              "en": {
                "description": "Maximum characters per danmaku (default 20; higher live levels allow more)."
              }
            }
          },
          "maxChunks": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "default": 2,
            "description": "一次回复最多拆成几条弹幕（默认 2），放不下的截断",
            "x-i18n": {
              "en": {
                "description": "Maximum danmaku per reply (default 2); the rest is truncated."
              }
            }
          },
          "minSendIntervalSec": {
            "type": "number",
            "minimum": 2,
            "default": 5,
            "description": "两次回复的最小间隔（秒），最小 2；不足时拒绝发送，不排队",
            "x-i18n": {
              "en": {
                "description": "Minimum seconds between two replies, at least 2; a reply sent sooner is rejected, not queued."
              }
            }
          },
          "apiBaseUrl": {
            "type": "string",
            "default": "https://api.bilibili.com"
          },
          "liveApiBaseUrl": {
            "type": "string",
            "default": "https://api.live.bilibili.com"
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "description": "本账号的映射规则；追加或覆盖适配器层同 match 的规则（ADR 0056 §4）",
            "x-i18n": {
              "en": {
                "description": "Mapping rules of this account; add to or override adapter-level rules with the same match (ADR 0056 §4)."
              }
            },
            "properties": {
              "inherit": {
                "type": "boolean",
                "default": true,
                "description": "false 时丢弃上级（含默认规则）的映射规则",
                "x-i18n": {
                  "en": {
                    "description": "false drops the rules from the levels above, the default rule included."
                  }
                }
              },
              "mappings": {
                "type": "array",
                "maxItems": 64,
                "default": [],
                "description": "映射规则列表；配置文件中只能授予 admin（或 none 取消上级同 match 规则），trusted / owner 只能在会话层（Console 或聊天）显式设置",
                "x-i18n": {
                  "en": {
                    "description": "Mapping rules. The configuration file can grant only admin (or none, which removes an inherited rule with the same match); trusted / owner mappings exist only at the conversation level (Console or chat)."
                  }
                },
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "match",
                    "grant"
                  ],
                  "properties": {
                    "match": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "给出的条件全部满足；每个条件内任一值满足即可",
                      "x-i18n": {
                        "en": {
                          "description": "Every given criterion must hold; any value within one criterion matches."
                        }
                      },
                      "properties": {
                        "standing": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "owner",
                              "admin",
                              "member",
                              "guest"
                            ]
                          },
                          "minItems": 1,
                          "description": "平台归一地位",
                          "x-i18n": {
                            "en": {
                              "description": "Normalized platform standing."
                            }
                          }
                        },
                        "role": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "description": "平台角色 id",
                          "x-i18n": {
                            "en": {
                              "description": "Platform role ids."
                            }
                          }
                        },
                        "permission": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "description": "平台权限名",
                          "x-i18n": {
                            "en": {
                              "description": "Platform permission names."
                            }
                          }
                        }
                      }
                    },
                    "grant": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "none"
                      ],
                      "description": "授予的会话角色；none 取消上级同 match 的规则",
                      "x-i18n": {
                        "en": {
                          "description": "Conversation role granted; none removes an inherited rule with the same match."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "commandPrefix": {
            "type": "string",
            "default": "",
            "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
            "x-i18n": {
              "en": {
                "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
              }
            }
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          }
        }
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
