{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "description": "平台身份 → zhin 聊天角色的映射规则（ADR 0056 §4）。结果只作用于消息所在会话、按平台身份实时计算；适配器层规则对其所有账号有效，账号层（endpoints[i].roles）追加或覆盖同 match 的规则。默认规则：standing 为 owner / admin → 会话 admin。",
      "x-i18n": {
        "en": {
          "description": "Platform identity → zhin chat role mapping rules (ADR 0056 §4). Results apply only to the conversation of the message and are computed live from the platform identity; adapter-level rules cover every account, account-level rules (endpoints[i].roles) add to or override rules with the same match. Default rule: standing owner / admin → conversation admin."
        }
      },
      "properties": {
        "inherit": {
          "type": "boolean",
          "default": true,
          "description": "false 时丢弃上级（含默认规则）的映射规则",
          "x-i18n": {
            "en": {
              "description": "false drops the rules from the levels above, the default rule included."
            }
          }
        },
        "mappings": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "description": "映射规则列表；配置文件中只能授予 admin（或 none 取消上级同 match 规则），trusted / owner 只能在会话层（Console 或聊天）显式设置",
          "x-i18n": {
            "en": {
              "description": "Mapping rules. The configuration file can grant only admin (or none, which removes an inherited rule with the same match); trusted / owner mappings exist only at the conversation level (Console or chat)."
            }
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "grant"
            ],
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": false,
                "description": "给出的条件全部满足；每个条件内任一值满足即可",
                "x-i18n": {
                  "en": {
                    "description": "Every given criterion must hold; any value within one criterion matches."
                  }
                },
                "properties": {
                  "standing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "admin",
                        "member",
                        "guest"
                      ]
                    },
                    "minItems": 1,
                    "description": "平台归一地位",
                    "x-i18n": {
                      "en": {
                        "description": "Normalized platform standing."
                      }
                    }
                  },
                  "role": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "平台角色 id",
                    "x-i18n": {
                      "en": {
                        "description": "Platform role ids."
                      }
                    }
                  },
                  "permission": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "平台权限名",
                    "x-i18n": {
                      "en": {
                        "description": "Platform permission names."
                      }
                    }
                  }
                }
              },
              "grant": {
                "type": "string",
                "enum": [
                  "admin",
                  "none"
                ],
                "description": "授予的会话角色；none 取消上级同 match 的规则",
                "x-i18n": {
                  "en": {
                    "description": "Conversation role granted; none removes an inherited rule with the same match."
                  }
                }
              }
            }
          }
        }
      }
    },
    "password": {
      "type": "string",
      "description": "QQ 密码（可选，不填则扫码登录）",
      "x-i18n": {
        "en": {
          "description": "QQ password (optional); scan a QR code to log in when omitted."
        }
      }
    },
    "platform": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "default": 1,
      "description": "登录设备平台：1=Android, 2=aPad, 3=Watch, 4=iMac, 5=iPad, 6=Tim, 7=Custom",
      "x-i18n": {
        "en": {
          "description": "Login device platform: 1=Android, 2=aPad, 3=Watch, 4=iMac, 5=iPad, 6=Tim, 7=Custom."
        }
      }
    },
    "ver": {
      "type": "string",
      "description": "协议版本号，仅在对应 platform 有多个版本时有效，不填则使用最新版本",
      "x-i18n": {
        "en": {
          "description": "Protocol version, only applicable when the selected platform has multiple versions. Uses the latest when omitted."
        }
      }
    },
    "signApiAddr": {
      "type": "string",
      "description": "签名服务器地址；未配置时若安装了 @icqqjs/qqsign 则自动使用本地签名",
      "x-i18n": {
        "en": {
          "description": "Signing server URL. When omitted, uses local signing automatically if @icqqjs/qqsign is installed."
        }
      }
    },
    "dataDir": {
      "type": "string",
      "description": "数据存储文件夹路径，默认为主模块下的 data 文件夹",
      "x-i18n": {
        "en": {
          "description": "Data directory path; defaults to the data directory under the main module."
        }
      }
    },
    "autoReconnect": {
      "type": "boolean",
      "default": true,
      "description": "断线后是否自动重连（默认 true）",
      "x-i18n": {
        "en": {
          "description": "Reconnect automatically after disconnecting (default true)."
        }
      }
    },
    "outboundMedia": {
      "type": "string",
      "enum": [
        "file",
        "base64"
      ],
      "default": "file",
      "description": "出站媒体模式：file=落盘本地路径（默认）; base64=CQ base64:// 内联",
      "x-i18n": {
        "en": {
          "description": "Outbound media mode: file uses local file paths (default); base64 uses inline CQ base64:// data."
        }
      }
    },
    "ignoreSelf": {
      "type": "boolean",
      "default": true,
      "description": "群聊和频道中是否过滤自己的消息（默认 true）",
      "x-i18n": {
        "en": {
          "description": "Filter the bot's own messages in groups and channels (default true)."
        }
      }
    },
    "resend": {
      "type": "boolean",
      "default": false,
      "description": "被风控时是否尝试用分片发送（默认 false）",
      "x-i18n": {
        "en": {
          "description": "Attempt fragmented sending when rate-limited by the platform (default false)."
        }
      }
    },
    "cacheGroupMember": {
      "type": "boolean",
      "default": true,
      "description": "是否缓存群员列表（默认 true）；群多时（500+）会多占约 100MB+ 内存",
      "x-i18n": {
        "en": {
          "description": "Cache group member lists (default true). Large numbers of groups (500+) may use approximately 100 MB or more of extra memory."
        }
      }
    },
    "autoServer": {
      "type": "boolean",
      "default": true,
      "description": "是否自动选择最优服务器（默认 true）",
      "x-i18n": {
        "en": {
          "description": "Automatically select the optimal server (default true)."
        }
      }
    },
    "qqnt": {
      "type": "boolean",
      "default": true,
      "description": "是否使用 QQNT 协议（默认 true）",
      "x-i18n": {
        "en": {
          "description": "Use the QQNT protocol (default true)."
        }
      }
    },
    "ntLogin": {
      "type": "boolean",
      "description": "是否使用 NT 登录方式",
      "x-i18n": {
        "en": {
          "description": "Use the NT login method."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "QQ uin"
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "description": "本账号的映射规则；追加或覆盖适配器层同 match 的规则（ADR 0056 §4）",
            "x-i18n": {
              "en": {
                "description": "Mapping rules of this account; add to or override adapter-level rules with the same match (ADR 0056 §4)."
              }
            },
            "properties": {
              "inherit": {
                "type": "boolean",
                "default": true,
                "description": "false 时丢弃上级（含默认规则）的映射规则",
                "x-i18n": {
                  "en": {
                    "description": "false drops the rules from the levels above, the default rule included."
                  }
                }
              },
              "mappings": {
                "type": "array",
                "maxItems": 64,
                "default": [],
                "description": "映射规则列表；配置文件中只能授予 admin（或 none 取消上级同 match 规则），trusted / owner 只能在会话层（Console 或聊天）显式设置",
                "x-i18n": {
                  "en": {
                    "description": "Mapping rules. The configuration file can grant only admin (or none, which removes an inherited rule with the same match); trusted / owner mappings exist only at the conversation level (Console or chat)."
                  }
                },
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "match",
                    "grant"
                  ],
                  "properties": {
                    "match": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "给出的条件全部满足；每个条件内任一值满足即可",
                      "x-i18n": {
                        "en": {
                          "description": "Every given criterion must hold; any value within one criterion matches."
                        }
                      },
                      "properties": {
                        "standing": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "owner",
                              "admin",
                              "member",
                              "guest"
                            ]
                          },
                          "minItems": 1,
                          "description": "平台归一地位",
                          "x-i18n": {
                            "en": {
                              "description": "Normalized platform standing."
                            }
                          }
                        },
                        "role": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "description": "平台角色 id",
                          "x-i18n": {
                            "en": {
                              "description": "Platform role ids."
                            }
                          }
                        },
                        "permission": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "description": "平台权限名",
                          "x-i18n": {
                            "en": {
                              "description": "Platform permission names."
                            }
                          }
                        }
                      }
                    },
                    "grant": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "none"
                      ],
                      "description": "授予的会话角色；none 取消上级同 match 的规则",
                      "x-i18n": {
                        "en": {
                          "description": "Conversation role granted; none removes an inherited rule with the same match."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "password": {
            "type": "string",
            "description": "本 endpoint 的 QQ 密码",
            "x-i18n": {
              "en": {
                "description": "QQ password for this endpoint."
              }
            }
          },
          "platform": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "description": "登录设备平台：1=Android, 2=aPad, 3=Watch, 4=iMac, 5=iPad, 6=Tim, 7=Custom",
            "x-i18n": {
              "en": {
                "description": "Login device platform: 1=Android, 2=aPad, 3=Watch, 4=iMac, 5=iPad, 6=Tim, 7=Custom."
              }
            }
          },
          "ver": {
            "type": "string",
            "description": "协议版本号",
            "x-i18n": {
              "en": {
                "description": "Protocol version."
              }
            }
          },
          "signApiAddr": {
            "type": "string",
            "description": "签名服务器地址",
            "x-i18n": {
              "en": {
                "description": "Signing server URL."
              }
            }
          },
          "dataDir": {
            "type": "string",
            "description": "数据存储文件夹路径",
            "x-i18n": {
              "en": {
                "description": "Data directory path."
              }
            }
          },
          "autoReconnect": {
            "type": "boolean",
            "description": "断线后是否自动重连",
            "x-i18n": {
              "en": {
                "description": "Reconnect automatically after disconnecting."
              }
            }
          },
          "outboundMedia": {
            "type": "string",
            "enum": [
              "file",
              "base64"
            ],
            "description": "出站媒体模式",
            "x-i18n": {
              "en": {
                "description": "Outbound media mode."
              }
            }
          },
          "ignoreSelf": {
            "type": "boolean",
            "description": "是否过滤自己的消息",
            "x-i18n": {
              "en": {
                "description": "Filter the bot's own messages."
              }
            }
          },
          "resend": {
            "type": "boolean",
            "description": "被风控时是否分片发送",
            "x-i18n": {
              "en": {
                "description": "Use fragmented sending when rate-limited by the platform."
              }
            }
          },
          "cacheGroupMember": {
            "type": "boolean",
            "description": "是否缓存群员列表",
            "x-i18n": {
              "en": {
                "description": "Cache group member lists."
              }
            }
          },
          "autoServer": {
            "type": "boolean",
            "description": "是否自动选择最优服务器",
            "x-i18n": {
              "en": {
                "description": "Automatically select the optimal server."
              }
            }
          },
          "qqnt": {
            "type": "boolean",
            "description": "是否使用 QQNT 协议",
            "x-i18n": {
              "en": {
                "description": "Use the QQNT protocol."
              }
            }
          },
          "ntLogin": {
            "type": "boolean",
            "description": "是否使用 NT 登录方式",
            "x-i18n": {
              "en": {
                "description": "Use the NT login method."
              }
            }
          },
          "commandPrefix": {
            "type": "string",
            "description": "本 endpoint 的命令前缀",
            "x-i18n": {
              "en": {
                "description": "Command prefix for this endpoint."
              }
            }
          },
          "notify": {
            "type": "object",
            "additionalProperties": false,
            "description": "掉线/登录失败时通过另一个适配器实例给 master 发通知（adapter/endpoint/kind/id 指向实际会话）",
            "x-i18n": {
              "en": {
                "description": "Send outage/login notices to the master through another adapter instance (adapter/endpoint/kind/id identify the actual conversation)."
              }
            },
            "properties": {
              "adapter": {
                "type": "string",
                "description": "通知使用的适配器类型，如 qq / icqq",
                "x-i18n": {
                  "en": {
                    "description": "Adapter type used for the notice, such as qq or icqq."
                  }
                }
              },
              "endpoint": {
                "type": "string",
                "description": "该适配器的 endpoint id",
                "x-i18n": {
                  "en": {
                    "description": "Endpoint id of that adapter."
                  }
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "private",
                  "group",
                  "channel"
                ],
                "default": "private",
                "description": "会话类型，默认 private",
                "x-i18n": {
                  "en": {
                    "description": "Conversation kind; defaults to private."
                  }
                }
              },
              "id": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "master 在该平台上的会话 id（QQ 官方为 openid，ICQQ 为 QQ 号）",
                "x-i18n": {
                  "en": {
                    "description": "Master conversation id on that platform (openid for QQ official, QQ number for ICQQ)."
                  }
                }
              },
              "parent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "private",
                      "group",
                      "channel"
                    ]
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "description": "可选的父频道/群容器"
              }
            },
            "required": [
              "adapter",
              "endpoint",
              "id"
            ]
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          }
        },
        "required": [
          "id"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix, empty by default. Each endpoints[i] can override it."
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "description": "掉线/登录失败时通过另一个适配器实例给 master 发通知（adapter/endpoint/kind/id 指向实际会话）",
      "x-i18n": {
        "en": {
          "description": "Send outage/login notices to the master through another adapter instance (adapter/endpoint/kind/id identify the actual conversation)."
        }
      },
      "properties": {
        "adapter": {
          "type": "string",
          "description": "通知使用的适配器类型，如 qq / icqq",
          "x-i18n": {
            "en": {
              "description": "Adapter type used for the notice, such as qq or icqq."
            }
          }
        },
        "endpoint": {
          "type": "string",
          "description": "该适配器的 endpoint id",
          "x-i18n": {
            "en": {
              "description": "Endpoint id of that adapter."
            }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "private",
            "group",
            "channel"
          ],
          "default": "private",
          "description": "会话类型，默认 private",
          "x-i18n": {
            "en": {
              "description": "Conversation kind; defaults to private."
            }
          }
        },
        "id": {
          "type": [
            "string",
            "number"
          ],
          "description": "master 在该平台上的会话 id（QQ 官方为 openid，ICQQ 为 QQ 号）",
          "x-i18n": {
            "en": {
              "description": "Master conversation id on that platform (openid for QQ official, QQ number for ICQQ)."
            }
          }
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "private",
                "group",
                "channel"
              ]
            },
            "id": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "可选的父频道/群容器"
        }
      },
      "required": [
        "adapter",
        "endpoint",
        "id"
      ]
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
