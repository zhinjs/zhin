{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiBaseUrl": {
      "type": "string",
      "default": "https://api.bilibili.com"
    },
    "pollIntervalSec": {
      "type": "number",
      "minimum": 60,
      "default": 60,
      "description": "轮询间隔（秒），最小 60，实际会加 0–20% 随机抖动"
    },
    "sendMode": {
      "type": "string",
      "enum": [
        "review",
        "off"
      ],
      "default": "review",
      "description": "出站模式：review=AI 回复只进草稿队列，master 用 bili-draft send <id> 审批后才发出（默认）；off=禁止出站。不提供自动直发"
    },
    "minSendIntervalSec": {
      "type": "number",
      "minimum": 10,
      "default": 30,
      "description": "审批后两次真实发送的最小间隔（秒），最小 10；不足时拒绝发送，不排队"
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "reply",
          "at"
        ]
      },
      "uniqueItems": true,
      "default": [],
      "description": "额外轮询的通知：reply=回复我的，at=@我的（需要 Cookie；只收视频评论）。默认不开"
    },
    "notificationScope": {
      "type": "string",
      "enum": [
        "whitelist",
        "all"
      ],
      "default": "whitelist",
      "description": "通知入站范围：whitelist=只收 videos 白名单视频下的通知（默认）；all=所有视频评论通知"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ]
      },
      "description": "白名单视频：BV 号或 av 号。只轮询这些视频的评论，不做全站搜索"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（B 站 uid）。endpoints[i].master 可逐项覆盖"
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted Bilibili uid"
      },
      "description": "框架 trusted 用户列表（B 站 uid）"
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Endpoint 名称（本地标识，不是 B 站账号）"
          },
          "sessdata": {
            "type": "string",
            "description": "Cookie SESSDATA（以你的账号身份操作；请用 ${BILIBILI_SESSDATA} 注入，切勿写入仓库）"
          },
          "biliJct": {
            "type": "string",
            "description": "Cookie bili_jct（csrf token；请用 ${BILIBILI_BILI_JCT} 注入）"
          },
          "videos": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "白名单视频：BV 号或 av 号。只轮询这些视频的评论，不做全站搜索"
          },
          "pollIntervalSec": {
            "type": "number",
            "minimum": 60,
            "default": 60,
            "description": "轮询间隔（秒），最小 60，实际会加 0–20% 随机抖动"
          },
          "sendMode": {
            "type": "string",
            "enum": [
              "review",
              "off"
            ],
            "default": "review",
            "description": "出站模式：review=AI 回复只进草稿队列，master 用 bili-draft send <id> 审批后才发出（默认）；off=禁止出站。不提供自动直发"
          },
          "minSendIntervalSec": {
            "type": "number",
            "minimum": 10,
            "default": 30,
            "description": "审批后两次真实发送的最小间隔（秒），最小 10；不足时拒绝发送，不排队"
          },
          "notifications": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reply",
                "at"
              ]
            },
            "uniqueItems": true,
            "default": [],
            "description": "额外轮询的通知：reply=回复我的，at=@我的（需要 Cookie；只收视频评论）。默认不开"
          },
          "notificationScope": {
            "type": "string",
            "enum": [
              "whitelist",
              "all"
            ],
            "default": "whitelist",
            "description": "通知入站范围：whitelist=只收 videos 白名单视频下的通知（默认）；all=所有视频评论通知"
          },
          "apiBaseUrl": {
            "type": "string",
            "default": "https://api.bilibili.com"
          },
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（B 站 uid）"
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted Bilibili uid"
            },
            "description": "本 endpoint 的 trusted 列表"
          },
          "commandPrefix": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "required": [
    "endpoints"
  ]
}
