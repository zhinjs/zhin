{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "botAgent": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string",
      "default": "https://ilinkai.weixin.qq.com"
    },
    "cdnBaseUrl": {
      "type": "string",
      "default": "https://novac2c.cdn.weixin.qq.com/c2c"
    },
    "longPollTimeoutMs": {
      "type": "number",
      "default": 35000
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（Weixin user id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖"
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted Weixin user id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加"
    },
    "endpoints": {
      "type": "array",
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（name 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Weixin iLink bot name"
          },
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（Weixin user id）；覆盖顶层 master"
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted Weixin user id"
            },
            "description": "本 endpoint 的 trusted 列表"
          },
          "botToken": {
            "type": "string",
            "description": "iLink bot token (prefer env WEIXIN_ILINK_TOKEN or sidecar credential file)"
          }
        },
        "required": [
          "name",
          "botToken"
        ]
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖"
    }
  },
  "required": [
    "endpoints"
  ]
}
