{
  "name": "@zhin.js/adapter-wechat-mp",
  "version": "1.1.29",
  "type": "module",
  "description": "WeChat Official Account adapter: HTTP webhook messaging with signature checks and optional AES encryption.",
  "keywords": [
    "zhin.js",
    "wechat",
    "微信",
    "official-account"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/adapters/wechat-mp/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@zhin.js/adapter": "workspace:*",
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/core": "workspace:*",
    "@zhin.js/feature-kit": "workspace:*",
    "@zhin.js/host-http": "workspace:*",
    "@zhin.js/host-http-contract": "workspace:*",
    "@zhin.js/im-contract": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "axios": "^1.20.0",
    "xml2js": "^0.6.2"
  },
  "peerDependencies": {
    "@zhin.js/adapter": "workspace:^",
    "@zhin.js/command": "workspace:^",
    "@zhin.js/core": "workspace:^",
    "@zhin.js/host-http": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "zhin.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/xml2js": "^0.4.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/zhinjs/zhin.git",
    "type": "git",
    "directory": "plugins/adapters/wechat-mp"
  },
  "files": [
    "adapters",
    "commands",
    "pages",
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/adapter",
        "api": "^2.1.0"
      },
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "WeChat Official Account Adapter",
      "displayNameI18n": {
        "zh-CN": "微信公众号适配器",
        "en": "WeChat Official Account Adapter"
      },
      "descriptionI18n": {
        "zh-CN": "微信公众号适配器：通过 HTTP Webhook 收发消息，支持签名校验与 AES 加解密。",
        "en": "WeChat Official Account adapter: HTTP webhook messaging with signature checks and optional AES encryption."
      },
      "category": "adapter"
    }
  }
}
