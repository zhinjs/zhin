{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "default": "/wechat/webhook"
    },
    "encrypt": {
      "type": "boolean",
      "default": false
    },
    "encryptMode": {
      "type": "string",
      "enum": [
        "plain",
        "compatible",
        "secure"
      ],
      "description": "Default follows encrypt: 'plain' when encrypt=false, 'compatible' when encrypt=true"
    },
    "replyMode": {
      "type": "string",
      "enum": [
        "passive",
        "customer_service"
      ],
      "default": "passive"
    },
    "passiveReplyTimeoutMs": {
      "type": "number",
      "default": 4500
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（WeChat OpenID；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (WeChat OpenID; AI/tool permissions and endpoint management). endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted WeChat OpenID"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（WeChat OpenID）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (WeChat OpenID), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted WeChat OpenID"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "appId": {
            "type": "string",
            "description": "WeChat MP app ID"
          },
          "appSecret": {
            "type": "string",
            "description": "WeChat MP app secret"
          },
          "token": {
            "type": "string",
            "description": "WeChat MP callback token"
          },
          "encodingAESKey": {
            "type": "string",
            "description": "WeChat MP encoding AES key"
          },
          "path": {
            "type": "string"
          },
          "encrypt": {
            "type": "boolean"
          },
          "encryptMode": {
            "type": "string",
            "enum": [
              "plain",
              "compatible",
              "secure"
            ]
          },
          "replyMode": {
            "type": "string",
            "enum": [
              "passive",
              "customer_service"
            ]
          },
          "passiveReplyTimeoutMs": {
            "type": "number"
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "WeChat MP bot name"
          }
        },
        "required": [
          "id",
          "appId",
          "appSecret",
          "token"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: mount multiple endpoints in one plugin instance. Each entry uses the top-level fields; id is required and other fields override defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    }
  },
  "required": [
    "endpoints"
  ]
}
