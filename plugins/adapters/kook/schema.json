{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connection": {
      "type": "string",
      "enum": [
        "websocket",
        "webhook"
      ],
      "default": "websocket",
      "description": "WebSocket gateway (default). webhook requires httpHostToken, verify_token, and a public HTTPS callback URL."
    },
    "webhookPath": {
      "type": "string",
      "default": "/kook/webhook",
      "description": "POST path registered via httpHostToken when connection is webhook."
    },
    "data_dir": {
      "type": "string"
    },
    "timeout": {
      "type": "number",
      "default": 10000
    },
    "max_retry": {
      "type": "number",
      "default": 3
    },
    "ignore": {
      "type": "string",
      "enum": [
        "bot",
        "self"
      ],
      "default": "bot"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal",
        "mark",
        "off"
      ],
      "default": "info"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（KOOK user id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖"
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted KOOK user id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加"
    },
    "endpoints": {
      "type": "array",
      "description": "多账号：一个插件实例挂多个 endpoint。每项与顶层字段同构（id 必填，其余覆盖顶层）",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（KOOK user id）；覆盖顶层 master"
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted KOOK user id"
            },
            "description": "本 endpoint 的 trusted 列表"
          },
          "token": {
            "type": "string",
            "description": "KOOK bot token"
          },
          "verify_token": {
            "type": "string",
            "description": "KOOK developer console verify token (required for webhook mode)."
          },
          "encrypt_key": {
            "type": "string",
            "description": "Optional Encrypt Key when message encryption is enabled in KOOK console."
          },
          "id": {
            "type": "string",
            "description": "KOOK bot name"
          }
        },
        "required": [
          "id",
          "token"
        ]
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖"
    }
  },
  "required": [
    "endpoints"
  ]
}
