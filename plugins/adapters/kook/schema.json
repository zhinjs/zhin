{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connection": {
      "type": "string",
      "enum": [
        "websocket",
        "webhook"
      ],
      "default": "websocket",
      "description": "WebSocket gateway (default). webhook requires httpHostToken, verify_token, and a public HTTPS callback URL."
    },
    "webhookPath": {
      "type": "string",
      "default": "/kook/webhook",
      "description": "POST path registered via httpHostToken when connection is webhook."
    },
    "data_dir": {
      "type": "string"
    },
    "timeout": {
      "type": "number",
      "default": 10000
    },
    "max_retry": {
      "type": "number",
      "default": 3
    },
    "ignore": {
      "type": "string",
      "enum": [
        "bot",
        "self"
      ],
      "default": "bot"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal",
        "mark",
        "off"
      ],
      "default": "info"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：每项定义一个 endpoint，id/token 必填，其余字段覆盖实例默认值",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "KOOK bot token"
          },
          "connection": {
            "type": "string",
            "enum": [
              "websocket",
              "webhook"
            ]
          },
          "webhookPath": {
            "type": "string"
          },
          "verify_token": {
            "type": "string",
            "description": "KOOK developer console verify token (required for webhook mode)."
          },
          "encrypt_key": {
            "type": "string",
            "description": "Optional Encrypt Key when message encryption is enabled in KOOK console."
          },
          "data_dir": {
            "type": "string"
          },
          "timeout": {
            "type": "number"
          },
          "max_retry": {
            "type": "number"
          },
          "ignore": {
            "type": "string",
            "enum": [
              "bot",
              "self"
            ]
          },
          "logLevel": {
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error",
              "fatal",
              "mark",
              "off"
            ]
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "KOOK bot name"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$"
              }
            },
            "required": [
              "port",
              "serverName"
            ],
            "description": "WSS故障验收固定loopback，保持真实TLS身份",
            "x-i18n": {
              "en": {
                "description": "Pin WSS fault-injection tests to loopback while preserving the actual TLS identity."
              }
            }
          },
          "apiProxy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "description": "Optional fixed loopback TCP route for www.kookapp.cn JSON API only; verified TLS remains enabled."
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "账号昵称兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account nickname"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/selfProfileFallback",
            "description": "账号资料兜底",
            "x-i18n": {
              "en": {
                "description": "Fallback account profile"
              }
            }
          }
        },
        "required": [
          "id",
          "token"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: each entry defines an endpoint. id and token are required; other fields override instance defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "description": "账号昵称兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account nickname"
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/selfProfileFallback",
      "description": "账号资料兜底",
      "x-i18n": {
        "en": {
          "description": "Fallback account profile"
        }
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "$defs": {
    "selfProfileFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "male",
            "female",
            "other",
            "unknown",
            null
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://[^\\s/?#]+(?:[/?#].*)?|)$"
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
