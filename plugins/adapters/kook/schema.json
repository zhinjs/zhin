{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connection": {
      "type": "string",
      "enum": [
        "websocket",
        "webhook"
      ],
      "default": "websocket",
      "description": "WebSocket gateway (default). webhook requires httpHostToken, verify_token, and a public HTTPS callback URL."
    },
    "webhookPath": {
      "type": "string",
      "default": "/kook/webhook",
      "description": "POST path registered via httpHostToken when connection is webhook."
    },
    "data_dir": {
      "type": "string"
    },
    "timeout": {
      "type": "number",
      "default": 10000
    },
    "max_retry": {
      "type": "number",
      "default": 3
    },
    "ignore": {
      "type": "string",
      "enum": [
        "bot",
        "self"
      ],
      "default": "bot"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal",
        "mark",
        "off"
      ],
      "default": "info"
    },
    "master": {
      "type": [
        "string",
        "number"
      ],
      "description": "框架 master（KOOK user id；AI/工具权限、endpoint 管理）。endpoints[i].master 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Framework masters (KOOK user id; AI/tool permissions and endpoint management). endpoints[i].master can override this value."
        }
      }
    },
    "trusted": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ],
        "description": "Trusted KOOK user id"
      },
      "description": "框架 trusted 用户列表（弱于 master）。endpoints[i].trusted 可逐项追加",
      "x-i18n": {
        "en": {
          "description": "Framework trusted users, below master authority. endpoints[i].trusted can add users."
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "多账号：每项定义一个 endpoint，id/token 必填，其余字段覆盖实例默认值",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "master": {
            "type": [
              "string",
              "number"
            ],
            "description": "本 endpoint 的框架 master（KOOK user id）；覆盖顶层 master",
            "x-i18n": {
              "en": {
                "description": "Framework masters for this endpoint (KOOK user id), overriding the top-level master list."
              }
            }
          },
          "trusted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ],
              "description": "Trusted KOOK user id"
            },
            "description": "本 endpoint 的 trusted 列表",
            "x-i18n": {
              "en": {
                "description": "Trusted users for this endpoint."
              }
            }
          },
          "token": {
            "type": "string",
            "description": "KOOK bot token"
          },
          "connection": {
            "type": "string",
            "enum": [
              "websocket",
              "webhook"
            ]
          },
          "webhookPath": {
            "type": "string"
          },
          "verify_token": {
            "type": "string",
            "description": "KOOK developer console verify token (required for webhook mode)."
          },
          "encrypt_key": {
            "type": "string",
            "description": "Optional Encrypt Key when message encryption is enabled in KOOK console."
          },
          "data_dir": {
            "type": "string"
          },
          "timeout": {
            "type": "number"
          },
          "max_retry": {
            "type": "number"
          },
          "ignore": {
            "type": "string",
            "enum": [
              "bot",
              "self"
            ]
          },
          "logLevel": {
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error",
              "fatal",
              "mark",
              "off"
            ]
          },
          "commandPrefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "KOOK bot name"
          },
          "streamProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "serverName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s/:@?#]+$"
              }
            },
            "required": [
              "port",
              "serverName"
            ],
            "description": "WSS故障验收固定loopback，保持真实TLS身份",
            "x-i18n": {
              "en": {
                "description": "Pin WSS fault-injection tests to loopback while preserving the actual TLS identity."
              }
            }
          },
          "apiProxy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "description": "Optional fixed loopback TCP route for www.kookapp.cn JSON API only; verified TLS remains enabled."
          }
        },
        "required": [
          "id",
          "token"
        ]
      },
      "x-i18n": {
        "en": {
          "description": "Multiple accounts: each entry defines an endpoint. id and token are required; other fields override instance defaults."
        }
      }
    },
    "commandPrefix": {
      "type": "string",
      "default": "",
      "description": "命令前缀（默认 '' 无前缀，任意文本按命令匹配；如 '/' 要求 / 开头）。endpoints[i] 可逐项覆盖",
      "x-i18n": {
        "en": {
          "description": "Command prefix. The default empty string allows unprefixed commands; '/' requires a leading slash. Each endpoints[i] can override it."
        }
      }
    }
  },
  "required": [
    "endpoints"
  ]
}
