{
  "name": "@zhin.js/plugin-roulette",
  "version": "0.1.18",
  "description": "Group members take turns pulling the trigger; each group can turn on a mute penalty for the loser.",
  "keywords": [
    "zhin.js",
    "roulette",
    "party-game",
    "俄罗斯轮盘"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "middlewares",
    "schedules",
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/games/roulette/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/core": "workspace:*",
    "@zhin.js/game-kit": "workspace:*"
  },
  "devDependencies": {
    "@zhin.js/schedule-feature": "workspace:*",
    "@zhin.js/testing": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/games/roulette"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/game-kit",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/schedule-feature",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Russian Roulette",
      "displayNameI18n": {
        "zh-CN": "俄罗斯轮盘",
        "en": "Russian Roulette"
      },
      "descriptionI18n": {
        "zh-CN": "群里多人轮流扣扳机，中弹者输，可按群开启输家禁言惩罚。",
        "en": "Group members take turns pulling the trigger; each group can turn on a mute penalty for the loser."
      },
      "category": "game"
    }
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/middleware": "workspace:^",
    "zhin.js": "workspace:^",
    "@zhin.js/schedule-feature": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/middleware": {
      "optional": true
    },
    "@zhin.js/schedule-feature": {
      "optional": true
    }
  }
}
