{
  "name": "@zhin.js/plugin-rps",
  "version": "1.1.29",
  "description": "Rock paper scissors, best of three, with game-hub buttons or text commands.",
  "keywords": [
    "zhin.js",
    "rock-paper-scissors",
    "rps",
    "猜拳"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "middlewares",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/games/rps/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/core": "workspace:*",
    "@zhin.js/game-kit": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/games/rps"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/game-kit",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "RPS",
      "displayNameI18n": {
        "zh-CN": "石头剪刀布",
        "en": "Rock Paper Scissors"
      },
      "descriptionI18n": {
        "zh-CN": "石头剪刀布，三局两胜，支持游戏大厅按钮与文本命令。",
        "en": "Rock paper scissors, best of three, with game-hub buttons or text commands."
      },
      "category": "game"
    }
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/middleware": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/middleware": {
      "optional": true
    }
  }
}
