{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-zhin-config": {
    "levels": [
      "global",
      "adapter",
      "endpoint",
      "conversation"
    ]
  },
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "是否启用进程监控",
      "x-i18n": {
        "zh-CN": {
          "title": "启用进程监控"
        },
        "en": {
          "title": "Enable process monitor",
          "description": "Enable process monitoring."
        }
      },
      "x-zhin-config": {
        "levels": [
          "global"
        ]
      }
    },
    "notifyOnStart": {
      "type": "boolean",
      "default": true,
      "description": "首次启动时通知",
      "x-i18n": {
        "zh-CN": {
          "title": "启动时通知"
        },
        "en": {
          "title": "Notify on start",
          "description": "Notify on first startup."
        }
      },
      "x-zhin-config": {
        "levels": [
          "global"
        ]
      }
    },
    "notifyOnRestart": {
      "type": "boolean",
      "default": true,
      "description": "正常重启时通知",
      "x-i18n": {
        "zh-CN": {
          "title": "重启时通知"
        },
        "en": {
          "title": "Notify on restart",
          "description": "Notify on normal restart."
        }
      },
      "x-zhin-config": {
        "levels": [
          "global"
        ]
      }
    },
    "notifyOnCrash": {
      "type": "boolean",
      "default": true,
      "description": "异常崩溃重启时通知",
      "x-i18n": {
        "zh-CN": {
          "title": "崩溃时通知"
        },
        "en": {
          "title": "Notify on crash",
          "description": "Notify after a crash restart."
        }
      },
      "x-zhin-config": {
        "levels": [
          "global"
        ]
      }
    },
    "notifyChannels": {
      "type": "array",
      "default": [],
      "description": "通知渠道（slice-1 仅 webhook 生效）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "type": "string",
            "x-i18n": {
              "zh-CN": {
                "title": "渠道类型",
                "description": "目前只支持 webhook"
              },
              "en": {
                "title": "Channel type",
                "description": "Only webhook is supported for now."
              }
            },
            "enum": [
              "webhook"
            ]
          },
          "target": {
            "type": "string",
            "x-i18n": {
              "zh-CN": {
                "title": "目标地址",
                "description": "Webhook 地址"
              },
              "en": {
                "title": "Target",
                "description": "Webhook URL."
              }
            }
          }
        }
      },
      "x-i18n": {
        "zh-CN": {
          "title": "通知渠道"
        },
        "en": {
          "title": "Notification channels",
          "description": "Notification channel (slice 1 supports webhook only)."
        }
      },
      "x-zhin-config": {
        "levels": [
          "global"
        ]
      }
    }
  }
}
