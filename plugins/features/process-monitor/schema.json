{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "是否启用进程监控",
      "x-i18n": {
        "en": {
          "description": "Enable process monitoring."
        }
      }
    },
    "notifyOnStart": {
      "type": "boolean",
      "default": true,
      "description": "首次启动时通知",
      "x-i18n": {
        "en": {
          "description": "Notify on first startup."
        }
      }
    },
    "notifyOnRestart": {
      "type": "boolean",
      "default": true,
      "description": "正常重启时通知",
      "x-i18n": {
        "en": {
          "description": "Notify on normal restart."
        }
      }
    },
    "notifyOnCrash": {
      "type": "boolean",
      "default": true,
      "description": "异常崩溃重启时通知",
      "x-i18n": {
        "en": {
          "description": "Notify after a crash restart."
        }
      }
    },
    "notifyChannels": {
      "type": "array",
      "default": [],
      "description": "通知渠道（slice-1 仅 webhook 生效）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "webhook"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      },
      "x-i18n": {
        "en": {
          "description": "Notification channel (slice 1 supports webhook only)."
        }
      }
    }
  }
}
