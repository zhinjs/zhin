{
  "name": "@zhin.js/process-monitor",
  "version": "1.1.21",
  "description": "Records starts, restarts and crashes, with a status command and a Console panel for memory and uptime.",
  "keywords": [
    "zhin.js",
    "monitoring",
    "process",
    "uptime",
    "restart"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "commands",
    "pages",
    "skills",
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/features/process-monitor/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/features/process-monitor"
  },
  "dependencies": {
    "@zhin.js/console-contract": "workspace:*",
    "@zhin.js/page": "workspace:*",
    "@zhin.js/skill": "workspace:*",
    "@zhin.js/tool": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/tool",
        "api": "^1.1.0"
      },
      {
        "package": "@zhin.js/skill",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/page",
        "api": "^1.0.0"
      }
    ],
    "plugins": [],
    "metadata": {
      "displayName": "Process Monitor",
      "displayNameI18n": {
        "zh-CN": "进程监控",
        "en": "Process Monitor"
      },
      "descriptionI18n": {
        "zh-CN": "记录启动、重启与崩溃次数，提供运行状态命令和 Console 内存 / 运行时长面板。",
        "en": "Records starts, restarts and crashes, with a status command and a Console panel for memory and uptime."
      },
      "category": "admin"
    }
  },
  "peerDependencies": {
    "@zhin.js/command": "workspace:^",
    "@zhin.js/page": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhin.js/command": {
      "optional": true
    },
    "@zhin.js/page": {
      "optional": true
    }
  }
}
