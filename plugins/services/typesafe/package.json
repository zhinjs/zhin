{
  "name": "@zhin.js/service-typesafe",
  "version": "1.0.22",
  "description": "Connects TypeSafe Choice and Score decision models to the inference runtime.",
  "keywords": [
    "zhin.js",
    "typesafe",
    "decision-model",
    "inference"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/services/typesafe/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@zhin.js/ai": "workspace:*"
  },
  "peerDependencies": {
    "zhin.js": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "zhin.js": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/services/typesafe"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [],
    "plugins": [],
    "metadata": {
      "displayName": "TypeSafe AI",
      "displayNameI18n": {
        "zh-CN": "TypeSafe 决策服务",
        "en": "TypeSafe AI"
      },
      "descriptionI18n": {
        "zh-CN": "为推理运行时提供 TypeSafe Choice / Score 决策模型接入。",
        "en": "Connects TypeSafe Choice and Score decision models to the inference runtime."
      },
      "category": "ai"
    }
  }
}
