{
  "name": "@zhin.js/service-activity-feedback",
  "version": "1.1.32",
  "description": "Shows typing, reactions or status messages while the AI is thinking or working, based on each platform's capabilities.",
  "keywords": [
    "zhin.js",
    "typing-indicator",
    "reactions",
    "ai-status"
  ],
  "author": {
    "name": "lc-cn",
    "url": "https://github.com/zhinjs/zhin"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "schema.json",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "vitest run --root ../../.. plugins/services/activity-feedback/tests",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node ../../../scripts/build-plugin-runtime-entries.mjs",
    "postpack": "node ../../../scripts/build-plugin-runtime-entries.mjs --clean"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "plugins/services/activity-feedback"
  },
  "dependencies": {
    "@zhin.js/agent": "workspace:*",
    "@zhin.js/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@zhin.js/testing": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zhin.js": "workspace:*"
  },
  "peerDependencies": {
    "@zhin.js/agent": "workspace:^",
    "zhin.js": "workspace:^"
  },
  "peerDependenciesMeta": {
    "zhin.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.js",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [],
    "plugins": [],
    "metadata": {
      "displayName": "Activity Feedback",
      "displayNameI18n": {
        "zh-CN": "活动反馈",
        "en": "Activity Feedback"
      },
      "descriptionI18n": {
        "zh-CN": "在 AI 思考和执行时按平台能力显示输入中、表情回应或状态消息。",
        "en": "Shows typing, reactions or status messages while the AI is thinking or working, based on each platform's capabilities."
      },
      "category": "service"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
