# 按下文填写凭据即可启动；维护者也可从 examples/test-bot（维护者厨房水槽，endpoint 名同为 zhin）复制
# cp ../test-bot/.env .env  后只保留 HTTP_TOKEN / QQ_APPID / QQ_SECRET

LOG_LEVEL=info
NODE_ENV=development

# Remote Console（与 test-bot 相同 token 时可共用）
HTTP_TOKEN=your-secret-token

# QQ 官方机器人（test-bot endpoints[].name: zhin）
QQ_APPID=
QQ_SECRET=
