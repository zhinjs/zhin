# 初始化令牌（zhin.config http.token）：仅在创建首个所有者之前有效，之后用账号登录
HTTP_TOKEN=full-bot-dev-token

# MCP / A2A 协议令牌（zhin.config mcp.token、a2a.token）；也可改用带 mcp.access / a2a.access 的 Console API 令牌
MCP_TOKEN=full-bot-mcp-dev-token
A2A_TOKEN=full-bot-a2a-dev-token

# 可选：OpenAI 兼容 API
# OPENAI_API_KEY=sk-...

# 默认：本地 Ollama
# ollama serve && ollama pull qwen3:8b

# NapCat（取消 zhin.config bots 注释后填写）
# ONEBOT11_ACCESS_TOKEN=
# ONEBOT11_WS_URL=ws://127.0.0.1:3001

# KOOK（取消 zhin.config bots 注释后填写）
# KOOK_TOKEN=
