# 飞书/钉钉 HTTP 验收。自行追加所需字段到现有 .env，保留其他配置。
# 先填写凭据，聊天 ID 暂用 pending 获取日志；获取后替换并重启。
LARK_MODE=websocket
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFY_TOKEN=
LARK_WEBHOOK_PATH=/lark/webhook
LARK_TEST_CHAT_ID=pending
LARK_TEST_CHAT_KIND=private

DINGTALK_MODE=stream
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_WEBHOOK_PATH=/dingtalk/webhook
DINGTALK_TEST_CHAT_ID=pending
DINGTALK_TEST_CHAT_KIND=private

# LINE HTTP Webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_WEBHOOK_PATH=/line/webhook
LINE_TEST_CHAT_ID=pending
LINE_TEST_CHAT_KIND=private
