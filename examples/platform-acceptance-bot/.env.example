# 只需填写要测试的平台；无需一次填完所有平台。实际凭据不要提交。
# 私聊/群聊任选一个受控目标；kind 可为 private、group、channel。
ACCEPTANCE_ACTIONS=reply-text
ACCEPTANCE_MIN_INTERVAL_MS=5000
ACCEPTANCE_MAX_SENDS=1000
ACCEPTANCE_SOAK_MIN_CONFIRMED=96
ACCEPTANCE_SOAK_MAX_GAP_MS=900000
ACCEPTANCE_SOAK_MAX_RSS_GROWTH_BYTES=33554432

# NapCat 正向 WS
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=
NAPCAT_BRIDGE_NAME=NapCat
NAPCAT_BRIDGE_VERSION=
NAPCAT_TEST_CHAT_KIND=private
NAPCAT_TEST_CHAT_ID=

# OneBot11 正向 WS：可使用同一个桥，但不要与 NapCat profile 同时启动。
ONEBOT11_WS_URL=ws://127.0.0.1:3001
ONEBOT11_ACCESS_TOKEN=
ONEBOT11_BRIDGE_NAME=NapCat
ONEBOT11_BRIDGE_VERSION=
ONEBOT11_TEST_CHAT_KIND=private
ONEBOT11_TEST_CHAT_ID=

# QQ 官方 WebSocket：测试沙箱应用填 true，正式应用填 false。
QQ_APP_ID=
QQ_APP_SECRET=
QQ_SANDBOX=true
QQ_BOT_KIND=public
QQ_TEST_CHAT_KIND=private
QQ_TEST_CHAT_ID=

# Telegram Polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_KIND=private
TELEGRAM_TEST_CHAT_ID=

# 可选进阶接入模式：不填写 MODE 时沿用上述已通过的默认模式。
# HTTP Host 默认只监听回环；桥在远端时自行决定监听地址与网络访问控制。
ACCEPTANCE_HTTP_HOST=127.0.0.1
ACCEPTANCE_HTTP_PORT=18080
# ws / wss / http；wss 代表反向 WS，不代表 TLS。
NAPCAT_MODE=ws
NAPCAT_REVERSE_WS_PATH=/napcat/reverse
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_POST_PATH=/napcat/events
# ws / wss
ONEBOT11_MODE=ws
ONEBOT11_REVERSE_WS_PATH=/onebot11/reverse
# websocket / webhook / middleware；后两者需要 QQ 后台配置公网 HTTPS 回调。
QQ_MODE=websocket
QQ_WEBHOOK_PATH=/qq/events
# polling / webhook；webhook 需要可转发到本地 Host 的公网 HTTPS 域名。
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/telegram/events
TELEGRAM_WEBHOOK_SECRET=

# 钉钉 Stream 原生互动卡片：可选；模板必须关联当前应用。
# 不配置模板时不能进行原生按钮回调验收；固定按钮数必须与模板一致（1–5）。
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_CARD_BUTTON_COUNT=2

# 可选：Stream故障验收，留空直连；TCP固定127.0.0.1，server name为实际网关域名
DINGTALK_STREAM_PROXY_PORT=
DINGTALK_STREAM_PROXY_SERVER_NAME=

# 可选：飞书WSS故障验收，留空直连；server name为实际gateway域名
LARK_STREAM_PROXY_PORT=
LARK_STREAM_PROXY_SERVER_NAME=

# 可选：Slack Socket故障验收；留空直连，域名失配拒绝
# 出站JSON API故障代理，仅固定slack.com:443，不影响Socket入站；默认留空
SLACK_WEB_API_PROXY_PORT=
SLACK_STREAM_PROXY_PORT=
SLACK_STREAM_PROXY_SERVER_NAME=

# Discord Gateway 故障注入：仅使用 ws://127.0.0.1:端口/，正常运行留空。
DISCORD_GATEWAY_FAULT_PROXY_URL=

# 可选：KOOK WSS故障验收，留空直连；保持真实gateway TLS身份
KOOK_STREAM_PROXY_PORT=
KOOK_STREAM_PROXY_SERVER_NAME=

# QQ 官方 WSS 受控 TCP 故障入口（认证/网关发现 HTTP/API/上传仍直连）
# 填固定 loopback TCP 代理端口及真实动态网关 hostname；不填则直连。
QQ_STREAM_PROXY_PORT=
QQ_STREAM_PROXY_SERVER_NAME=

# Discord出站REST专用TLS透明代理，独立于Gateway；默认留空
DISCORD_REST_API_PROXY_PORT=
