# 只把需要的字段追加到你现有 .env；不要用本文件覆盖 .env。
DISCORD_BOT_TOKEN=
DISCORD_TEST_CHAT_ID=
DISCORD_TEST_CHAT_KIND=channel
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEST_CHAT_ID=
SLACK_TEST_CHAT_KIND=group
SLACK_COMMAND_PREFIX=!
KOOK_BOT_TOKEN=
KOOK_TEST_CHAT_ID=
KOOK_TEST_CHAT_KIND=channel
EMAIL_SMTP_HOST=
# 可选：TCP代理场景保留原SMTP域名，证书校验保持开启
EMAIL_SMTP_SERVER_NAME=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
# 可选：TCP代理场景保留原IMAP域名，证书校验保持开启
EMAIL_IMAP_SERVER_NAME=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_TEST_CHAT_ID=
EMAIL_TEST_CHAT_KIND=private
