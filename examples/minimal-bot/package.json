{
  "name": "minimal-bot",
  "private": true,
  "version": "0.0.37",
  "description": "Zhin.js Plugin Runtime Stable golden path",
  "type": "module",
  "scripts": {
    "dev": "zhin start --foreground --watch source config",
    "start": "zhin start --foreground --mode production --no-watch",
    "daemon": "zhin start --mode production --no-watch",
    "stop": "zhin stop",
    "build": "tsc --noEmit",
    "test": "vitest run --root ../.. examples/minimal-bot/tests"
  },
  "dependencies": {
    "@zhin.js/command": "workspace:*",
    "@zhin.js/component": "workspace:*",
    "@zhin.js/tool": "workspace:*",
    "zhin.js": "workspace:*",
    "zod": "^4.4.3",
    "@zhin.js/components": "workspace:*",
    "@zhin.js/middleware": "workspace:*",
    "@zhin.js/cli": "workspace:*",
    "@zhin.js/gateway": "workspace:*"
  },
  "devDependencies": {
    "@zhin.js/runtime": "workspace:*",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.ts",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/tool",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/command",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/component",
        "api": "^1.0.0"
      },
      {
        "package": "@zhin.js/middleware",
        "api": "^1.0.0"
      }
    ],
    "plugins": []
  }
}
