{
  "name": "@zhin.js/self-delivery-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zhin start --foreground --watch source config",
    "start": "zhin start --foreground",
    "test": "vitest run --root ../.. examples/self-delivery-bot/tests"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.ts",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/command"
      }
    ],
    "plugins": []
  },
  "dependencies": {
    "zhin.js": "workspace:*",
    "@zhin.js/command": "workspace:*",
    "@zhin.js/harness": "workspace:*"
  },
  "devDependencies": {
    "@zhin.js/runtime": "workspace:*"
  }
}
