{
  "name": "multi-agent-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zhin start --foreground --watch source config",
    "start": "zhin start --foreground --mode production --no-watch",
    "build": "tsc --noEmit",
    "test": "vitest run --root ../.. examples/multi-agent-room/tests"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.ts",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [
      {
        "package": "@zhin.js/agent-feature",
        "api": "^1.0.0"
      }
    ],
    "plugins": []
  },
  "dependencies": {
    "zhin.js": "workspace:*",
    "@zhin.js/agent": "workspace:*",
    "@zhin.js/agent-feature": "workspace:*",
    "@zhin.js/adapter-sandbox": "workspace:*",
    "ai": "^7.0.44",
    "@ai-sdk/openai-compatible": "^3.0.18",
    "zod": "^4.4.3",
    "@zhin.js/cli": "workspace:*",
    "@zhin.js/gateway": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
