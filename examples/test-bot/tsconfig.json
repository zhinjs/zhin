{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@types/node", "@types/bun", "zhin.js", "@zhin.js/adapter-sandbox"],
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "zhin.js"
  },
  "include": [
    "plugin.ts",
    "commands/**/*",
    "tools/**/*",
    "components/**/*",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "client/**/*",
    "agents/**/*.ts",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "lib/plugins"]
}
