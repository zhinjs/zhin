{
  "name": "zhin-playground",
  "private": true,
  "version": "4.0.0",
  "description": "Zhin.js Plugin Runtime Playground — Hugging Face Spaces (Sandbox + OpenRouter free)",
  "type": "module",
  "scripts": {
    "dev": "zhin start --foreground",
    "start": "zhin start --foreground --mode production --no-watch",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.18",
    "@zhin.js/adapter-sandbox": "^1.1.30",
    "@zhin.js/agent": "^1.1.51",
    "@zhin.js/cli": "^1.1.32",
    "@zhin.js/gateway": "^1.1.0",
    "ai": "^7.0.44",
    "tsx": "^4.23.1",
    "zhin.js": "^1.1.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "zhin": {
    "protocol": 1,
    "type": "plugin",
    "entry": "./plugin.ts",
    "engine": "^1.0.0",
    "runtime": "trusted",
    "features": [],
    "plugins": []
  }
}
