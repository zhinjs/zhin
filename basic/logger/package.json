{
  "name": "@zhin.js/logger",
  "version": "1.1.3",
  "description": "Structured logging system for Zhin.js bot framework",
  "main": "./lib/index.js",
  "type": "module",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "dev": "tsc --watch",
    "test": "cd ../.. && vitest run basic/logger/tests",
    "test:coverage": "cd ../.. && vitest run basic/logger/tests --coverage"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "zhin",
    "bot",
    "logger",
    "logging",
    "structured",
    "debug"
  ],
  "author": "Zhin Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js",
        "default": "./lib/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "basic/logger"
  }
}
