{
  "name": "@zhin.js/cli",
  "version": "1.4.0",
  "description": "Command-line interface for Zhin.js bot framework",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "zhin": "./bin/zhin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "shared"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@zhin.js/console-protocol": "workspace:*",
    "@zhin.js/gateway": "workspace:*",
    "@zhin.js/host-http": "workspace:*",
    "@zhin.js/logger": "workspace:*",
    "@zhin.js/pagemanager": "workspace:*",
    "@zhin.js/plugin-runtime": "workspace:*",
    "@zhin.js/runtime": "workspace:*",
    "@zhin.js/scaffold-wizard": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.1",
    "fs-extra": "^11.4.0",
    "import-meta-resolve": "4.2.0",
    "inquirer": "^14.0.2",
    "open": "^11.0.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "peerDependencies": {
    "typescript": ">=5.8.0 <7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "basic/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "keywords": [
    "zhin",
    "bot",
    "cli",
    "command-line",
    "tool"
  ]
}
