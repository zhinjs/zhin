{
  "name": "@zhin.js/schedule",
  "version": "1.1.5",
  "description": "Calendar semantic scheduler for Zhin.js — solar, lunar, statutory holidays, workdays, scatter",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "cd ../.. && vitest run basic/schedule/tests",
    "next-runs": "node scripts/next-runs.mjs",
    "sync-holiday": "node scripts/sync-holiday.mjs",
    "sync-holidays-auto": "node scripts/sync-holidays-auto.mjs",
    "generate-holiday-calendar": "node scripts/generate-holiday-calendar.mjs"
  },
  "keywords": [
    "zhin",
    "scheduler",
    "cron",
    "chinese-calendar",
    "lunar",
    "holiday",
    "workday"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "basic/schedule"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  }
}
