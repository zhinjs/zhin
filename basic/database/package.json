{
  "name": "@zhin.js/database",
  "version": "1.1.5",
  "description": "Universal database abstraction layer for Zhin.js - supports SQLite, MySQL, PostgreSQL, MongoDB, Redis",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "development": "./src/index.ts"
    },
    "./registry": {
      "types": "./lib/registry.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "development": "./src/index.ts"
    },
    "./dialects/mysql": {
      "types": "./lib/dialects/mysql.d.ts",
      "import": "./lib/dialects/mysql.js",
      "require": "./lib/dialects/mysql.js",
      "development": "./src/dialects/mysql.ts"
    },
    "./dialects/pg": {
      "types": "./lib/dialects/pg.d.ts",
      "import": "./lib/dialects/pg.js",
      "require": "./lib/dialects/pg.js",
      "development": "./src/dialects/pg.ts"
    },
    "./dialects/mongodb": {
      "types": "./lib/dialects/mongodb.d.ts",
      "import": "./lib/dialects/mongodb.js",
      "require": "./lib/dialects/mongodb.js",
      "development": "./src/dialects/mongodb.ts"
    },
    "./dialects/redis": {
      "types": "./lib/dialects/redis.d.ts",
      "import": "./lib/dialects/redis.js",
      "require": "./lib/dialects/redis.js",
      "development": "./src/dialects/redis.ts"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@zhin.js/logger": "workspace:*"
  },
  "peerDependencies": {
    "mongodb": ">=3.1.13",
    "mysql2": ">=3.9.8",
    "pg": ">=2.11.2",
    "redis": "latest"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhinjs/zhin.git",
    "directory": "basic/database"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "./registry": {
        "types": "./lib/registry.d.ts",
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "./dialects/mysql": {
        "types": "./lib/dialects/mysql.d.ts",
        "import": "./lib/dialects/mysql.js",
        "require": "./lib/dialects/mysql.js"
      },
      "./dialects/pg": {
        "types": "./lib/dialects/pg.d.ts",
        "import": "./lib/dialects/pg.js",
        "require": "./lib/dialects/pg.js"
      },
      "./dialects/mongodb": {
        "types": "./lib/dialects/mongodb.d.ts",
        "import": "./lib/dialects/mongodb.js",
        "require": "./lib/dialects/mongodb.js"
      },
      "./dialects/redis": {
        "types": "./lib/dialects/redis.d.ts",
        "import": "./lib/dialects/redis.js",
        "require": "./lib/dialects/redis.js"
      }
    }
  },
  "keywords": [
    "zhin",
    "bot",
    "database",
    "orm",
    "sqlite",
    "mysql",
    "postgresql",
    "mongodb",
    "redis"
  ]
}
