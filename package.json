{
  "name": "zhin",
  "version": "1.0.0",
  "description": "TypeScript机器人框架",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@9.0.2",
  "scripts": {
    "dev": "pnpm --filter minimal-bot dev",
    "dev:test": "pnpm --filter test-bot dev",
    "dev:full": "pnpm --filter full-bot dev",
    "preview:ui": "vite --config scripts/adapter-preview/vite.config.mts",
    "preview:components": "pnpm --filter @zhin.js/components preview:serve",
    "start": "pnpm --filter minimal-bot start",
    "release": "pnpm changeset",
    "bump": "pnpm changeset version",
    "pub": "pnpm changeset publish",
    "init": "pnpm install",
    "zhin:local": "node scripts/zhin-local.mjs",
    "prepare:logger": "pnpm --filter @zhin.js/logger build && pnpm --filter @zhin.js/schedule build && pnpm --filter @zhin.js/cli install",
    "prepare:cli": "pnpm --filter @zhin.js/scaffold-wizard build && pnpm --filter @zhin.js/cli build && pnpm install",
    "build": "turbo run build --filter=./basic/** --filter=./packages/** --filter=./plugins/**",
    "clean": "turbo run clean && rimraf .turbo/cache",
    "lint": "eslint .",
    "lint:ci": "eslint . --quiet",
    "check:harness-paths": "node scripts/check-im-send-bypass.mjs",
    "check:no-koa": "node scripts/check-no-koa-imports.mjs",
    "check:architecture": "node scripts/check-architecture-layers.mjs",
    "check:domain-module-boundaries": "node scripts/check-domain-module-boundaries.mjs",
    "check:console-client-boundaries": "node scripts/check-console-client-boundaries.mjs",
    "check:console-protocol-boundaries": "node scripts/check-console-protocol-boundaries.mjs",
    "check:sixty-s-runtime-boundaries": "node scripts/check-sixty-s-runtime-boundaries.mjs",
    "check:agent-tool-authoring-boundaries": "node scripts/check-agent-tool-authoring-boundaries.mjs",
    "check:adapter-endpoint-boundaries": "node scripts/check-adapter-endpoint-boundaries.mjs",
    "check:runtime-config-boundaries": "node scripts/check-runtime-config-boundaries.mjs",
    "check:im-session-ssot": "node scripts/check-im-session-ssot.mjs",
    "check:llm-runtime-boundaries": "node scripts/check-llm-runtime-boundaries.mjs",
    "check:speech-runtime-boundaries": "node scripts/check-speech-runtime-boundaries.mjs",
    "check:legacy-ai-exports": "node scripts/check-legacy-ai-exports.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:install-tiers-ssot": "node scripts/check-install-tiers-ssot.mjs",
    "check:dependency-policy": "node scripts/check-dependency-policy.mjs",
    "check:release-plan": "node scripts/check-release-plan.mjs",
    "check:api-surface": "node scripts/check-api-surface.mjs",
    "check:plugin-config-schemas": "node scripts/sync-plugin-config-schemas.mjs --check",
    "check:plugin-runtime-api": "node scripts/check-plugin-runtime-api.mjs",
    "check:doc-orphans": "node scripts/check-doc-orphans.mjs",
    "check:readme-exports": "node scripts/check-readme-exports.mjs",
    "check:console-contract": "vitest run scripts/workspace-pack-closure.test.ts && node scripts/check-console-contract.mjs",
    "check:config-docs": "vitest run tests/docs/config-docs-alignment.test.ts",
    "check:config-enums": "vitest run tests/docs/config-enum-reference.test.ts",
    "check:operability-docs": "vitest run tests/docs/operability-docs.test.ts",
    "check:adapter-docs": "node scripts/sync-adapter-docs.mjs --check",
    "check:publishing-manifest": "node scripts/sync-publishing-manifest.mjs --check",
    "check:platform-tiers-ssot": "node scripts/check-platform-tiers-ssot.mjs",
    "sync:adapter-docs": "node scripts/sync-adapter-docs.mjs",
    "sync:publishing-manifest": "node scripts/sync-publishing-manifest.mjs",
    "sync:publish-exports": "node scripts/sync-publish-exports.mjs",
    "check:stable": "node scripts/run-stable-smoke.mjs",
    "check:created-project": "node scripts/check-created-project.mjs",
    "check:created-project:onebot11": "node scripts/check-created-project.mjs --onebot11",
    "check:created-project:napcat": "node scripts/check-created-project.mjs --napcat",
    "check:created-project:telegram": "node scripts/check-created-project.mjs --telegram",
    "check:created-project:qq": "node scripts/check-created-project.mjs --qq",
    "check:plugin-scaffold": "node scripts/check-plugin-scaffold.mjs",
    "check:platform-candidates": "node scripts/check-platform-candidates.mjs",
    "check:platform-auth": "node scripts/check-platform-auth.mjs",
    "check:l4": "node scripts/run-l4-check.mjs",
    "check:l4-ci": "node scripts/run-l4-ci-check.mjs",
    "check:outbound-media-policies": "node scripts/check-outbound-media-policies.mjs",
    "check:ai-outbound": "node scripts/check-ai-outbound-adapters.mjs",
    "check:interactive-segments": "node scripts/check-interactive-segment-adapters.mjs",
    "check:segments": "node scripts/check-segment-adapters.mjs",
    "check:provider-gateway": "node scripts/check-provider-gateway.mjs",
    "check:delivery": "vitest run examples/self-delivery-bot/tests/pipeline.test.ts examples/self-delivery-bot/tests/runtime.test.ts tests/docs/self-delivery-release-gates.test.ts tests/deploy/huggingface-canary.test.ts tests/docs/self-delivery-ci-credentials.test.ts scripts/self-delivery-smoke-receipt.test.ts",
    "check:a2a-mesh": "node scripts/check-a2a-mesh.mjs",
    "check:feature-peers": "node scripts/check-feature-peers.mjs",
    "check:no-platform-branches": "node scripts/check-no-platform-branches.mjs",
    "check:no-removed-plugin-api": "node scripts/check-no-removed-plugin-api.mjs",
    "check:plugin-runtime-migration-readiness": "node scripts/check-plugin-runtime-migration-readiness.mjs",
    "check:plugin-runtime-migration-verify": "pnpm exec vitest run basic/cli/tests/plugin-runtime/migration-verify.test.ts",
    "check:ci-preflight": "node scripts/check-ci-preflight.mjs",
    "check:all": "node scripts/check-all-harness.mjs",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "link": "pnpm --filter @zhin.js/cli exec npm link",
    "test": "vitest run",
    "eval:agent": "turbo run eval --filter=@zhin.js/agent",
    "eval:nightly": "pnpm -F @zhin.js/agent eval:nightly",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "create": "node packages/toolkit/create-zhin/lib/index.js",
    "docs:dev": "pnpm --filter @zhin.js/docs dev",
    "docs:build": "pnpm docs:api && pnpm docs:config && pnpm docs:troubleshooting && pnpm --filter @zhin.js/docs build",
    "docs:preview": "pnpm --filter @zhin.js/docs preview",
    "test:docs:e2e": "VITE_DOCS_INSIGHTS_ENDPOINT=/__docs-insights VITE_DOCS_INSIGHTS_SITE_ID=zhin-docs-test pnpm docs:build && pnpm test:docs:e2e:run",
    "test:docs:e2e:run": "playwright test --config playwright.docs.config.ts",
    "check:deployment-templates": "vitest run tests/docs/deployment-templates.test.ts",
    "docs:api": "typedoc",
    "eval:budget": "turbo run build --filter=@zhin.js/agent... --output-logs=errors-only && tsx --conditions=development packages/im/agent/evals/budget/run.ts",
    "eval:chat": "tsx --conditions=development evals/chat/run.ts",
    "docs:config": "node scripts/generate-config-reference.mjs",
    "check:config-reference": "node scripts/generate-config-reference.mjs --check",
    "docs:troubleshooting": "node scripts/generate-troubleshooting.mjs",
    "check:troubleshooting": "node scripts/generate-troubleshooting.mjs --check",
    "check:api-docs": "node scripts/check-api-docs-surface.mjs",
    "check:prod": "node scripts/check-production-config.js",
    "check:plugin": "node scripts/check-plugin-spec.mjs",
    "check:plugin-capability-publish": "node scripts/check-plugin-capability-publish.mjs",
    "check:pack-imports": "node scripts/check-pack-imports.mjs",
    "check:publish-repository": "node scripts/check-publish-repository.mjs",
    "check:unpublished": "node scripts/check-unpublished-packages.mjs",
    "check:agent-tool-schema": "node scripts/check-agent-tool-schema.mjs",
    "check:skill-authoring-boundaries": "node scripts/check-skill-authoring-boundaries.mjs",
    "check:agent-authoring-boundaries": "node scripts/check-agent-authoring-boundaries.mjs",
    "check:hook-authoring-boundaries": "node scripts/check-hook-authoring-boundaries.mjs",
    "check:install-size": "node scripts/check-install-size.mjs",
    "check:agent-config-inventory": "node scripts/check-agent-config-inventory.mjs",
    "check:database-types": "node scripts/check-database-optional-types.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.18.0",
    "chalk": "^5.6.2",
    "eslint": "^10.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zhin.js": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "@discordjs/rest>undici": "^6.29.1",
      "discord.js>undici": "^6.29.1",
      "utf7>semver": "^5.7.2",
      "hono": "4.13.14",
      "nodemailer": "^10.1.4",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
      "qs": "^6.16.0",
      "tar": "^7.5.16",
      "ip-address": "^10.7.4",
      "dompurify": "3.4.17",
      "read-yaml-file>js-yaml": "4.3.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "vitest@>=2.1.0 <4.1.12": "4.1.12",
      "@vitest/mocker@>=2.1.0 <4.1.12": "4.1.12",
      "tsup>esbuild": "^0.28.1",
      "bundle-require>esbuild": "^0.28.1",
      "vite": "^6.4.5",
      "brace-expansion": "^5.0.12",
      "qq-official-bot>axios": "^1.20.0",
      "axios@<1.20.0": "^1.20.0",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "mermaid@>=11.0.0-alpha.1 <11.16.1": "11.16.1",
      "protobufjs@<7.6.5": "7.6.5",
      "nanoid@<3.3.18": "3.3.18",
      "undici@<6.29.1": "^6.29.1",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "follow-redirects@<1.16.1": "^1.16.1",
      "proxy-addr@<2.0.8": "^2.0.8",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "vitest>vite": "^6.4.5",
      "@vitest/mocker>vite": "^6.4.5",
      "markdown-it@>=14.0.0 <14.3.3": "14.3.3",
      "katex@<0.18.2": "0.18.11",
      "source-map-js@<1.2.2": "1.2.2",
      "semver@<5.7.2": ">=5.7.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "preact@>=10.28.0 <10.28.2": ">=10.28.2",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.4",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "express-rate-limit@>=8.2.0 <8.2.2": ">=8.2.2",
      "flatted@<3.4.2": ">=3.4.2",
      "lodash@<4.18.1": ">=4.18.1",
      "uuid@<11.1.1": ">=11.1.1",
      "mysql2@<3.9.8": ">=3.9.8",
      "ajv@<6.14.0": ">=6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0"
    }
  }
}
