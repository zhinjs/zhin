{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/im/plugin-runtime/src/plugin.ts",
    "packages/im/command/src/definition.ts",
    "packages/im/adapter/src/definition.ts",
    "packages/im/component/src/definition.ts",
    "packages/im/middleware/src/definition.ts",
    "packages/im/handler/src/definition.ts",
    "packages/im/tool/src/definition.ts",
    "packages/im/skill/src/definition.ts",
    "packages/im/prompt-section/src/definition.ts",
    "packages/im/core/src/plugin-runtime/im/public-api.ts",
    "packages/im/agent/src/resource-hub/public-api.ts",
    "packages/host/http/src/public-api.ts"
  ],
  "out": "docs/public/api",
  "name": "Zhin.js Public API Reference",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "exclude": [
    "**/node_modules/**",
    "**/lib/**",
    "**/tests/**",
    "**/*.test.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "githubPages": false,
  "hideGenerator": true,
  "searchInComments": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "invalidLink": true,
    "notDocumented": false,
    "notExported": false
  },
  "navigationLinks": {
    "Zhin.js": "https://zhin.pages.dev",
    "GitHub": "https://github.com/zhinjs/zhin"
  }
}
