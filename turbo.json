{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "client/**",
        "bin/**",
        "shared/**",
        "scripts/**",
        "package.json",
        "tsconfig*.json",
        "vite.config.*"
      ],
      "outputs": ["lib/**", "dist/**", ".vitepress/dist/**"],
      "env": ["NODE_OPTIONS"]
    },
    "build:node": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": ["tsconfig.base.json"]
}